<aside class="w-64 min-h-full bg-base-100 border-r border-base-200 flex flex-col" data-role="sidebar">
  <%# Brand %>
  <%= link_to root_path, class: "flex items-center gap-2 px-4 h-16 border-b border-base-200 shrink-0" do %>
    <span class="inline-grid place-items-center size-8 rounded-lg bg-primary text-primary-content font-bold">C</span>
    <span class="text-lg font-semibold">Corobook</span>
  <% end %>

  <%# Primary nav %>
  <nav class="flex-1 overflow-y-auto p-3">
    <p class="px-2 pb-1 text-xs font-medium uppercase tracking-wide text-base-content/50"><%= t("nav.library_heading") %></p>
    <ul class="menu sidebar-menu w-full gap-0.5 p-0">
      <li>
        <%= link_to root_path, class: nav_active_class("/") do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/></svg>
          <%= t("nav.home") %>
        <% end %>
      </li>
      <li>
        <%= link_to songs_path, class: nav_active_class("/songs") do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9 19.5 6.75v8.25M9 9v8.25m0-8.25-.75.161M9 17.25a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm10.5-2.25a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/></svg>
          <%= t("nav.songs") %>
        <% end %>
      </li>
      <li>
        <%= link_to text_slides_path, class: nav_active_class("/text_slides") do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75h16.5v12.75H3.75zM12 16.5v3.75m-3 0h6"/></svg>
          <%= t("nav.slides") %>
        <% end %>
      </li>
      <li>
        <%= link_to service_sets_path, class: nav_active_class("/sets") do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
          <%= t("nav.services") %>
        <% end %>
      </li>
    </ul>

    <% if respond_to?(:current_user) && current_user&.admin? %>
      <p class="px-2 pb-1 pt-4 text-xs font-medium uppercase tracking-wide text-base-content/50"><%= t("nav.admin_heading") %></p>
      <ul class="menu sidebar-menu w-full gap-0.5 p-0">
        <li>
          <%= link_to team_path, class: nav_active_class("/team"), data: { role: "nav-team" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
            <%= t("nav.team") %>
          <% end %>
        </li>
        <li>
          <%= link_to usage_report_path, class: nav_active_class("/reports"), data: { role: "nav-usage" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125z"/></svg>
            <%= t("nav.usage_report") %>
          <% end %>
        </li>
        <li>
          <%# Settings as a nested submenu (DaisyUI static nested list): the parent links to
              General, with the sub-pages as a nested list beneath it. The parent is NOT marked
              active — only the current sub-item highlights, so there is no double black fill. %>
          <%= link_to settings_path, class: "", data: { role: "nav-settings" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.241.437-.613.43-.992a7.723 7.723 0 0 1 0-.255c.007-.378-.138-.75-.43-.991l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.281Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
            <%= t("nav.settings") %>
          <% end %>
          <ul class="sidebar-submenu" data-role="settings-submenu">
            <li>
              <%= link_to t("nav.settings_general"), settings_path,
                    class: (request.path == settings_path ? "menu-active" : ""),
                    data: { role: "nav-settings-general" } %>
            </li>
            <li>
              <%= link_to t("nav.settings_projection"), projection_settings_path,
                    class: nav_active_class("/settings/projection"),
                    data: { role: "nav-settings-projection" } %>
            </li>
          </ul>
        </li>
      </ul>
    <% end %>
  </nav>
</aside>
