<p><%= t("auth.mailer.invite.greeting") %></p>

<p>
  <%= t("auth.mailer.invite.body_html", inviter: @inviter.email, church: content_tag(:strong, @church.name), role: content_tag(:strong, @role)) %>
</p>

<div class="btn-wrap">
  <a href="<%= @url %>" class="btn"><%= t("auth.mailer.invite.cta") %></a>
</div>

<p class="muted"><%= t("auth.mailer.invite.paste_link") %></p>
<p><a href="<%= @url %>" class="link-fallback"><%= @url %></a></p>

<p class="muted"><%= t("auth.mailer.invite.expires") %></p>
