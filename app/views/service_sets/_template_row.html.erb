<%# One template on the Services page's Templates tab. Locals: template (ServiceSet). %>
<li class="list-row items-center hover:bg-base-200" data-role="template-row">
  <span class="inline-grid place-items-center size-12 rounded-box bg-base-200 text-primary" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m13.5-3A2.25 2.25 0 0 1 19.5 9v.878m0 0a2.246 2.246 0 0 0-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0 1 21 12v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6c0-.98.626-1.813 1.5-2.122"/></svg>
  </span>
  <%= link_to service_set_path(template), class: "list-col-grow min-w-0" do %>
    <span class="flex items-center gap-2 min-w-0">
      <span class="font-medium truncate"><%= template.name %></span>
      <% if template.id == current_church.default_template_id %>
        <span class="badge badge-soft badge-primary badge-sm shrink-0" data-role="default-badge"><%= t("services.template.default") %></span>
      <% end %>
    </span>
    <% if template.set_items.empty? %>
      <span class="block text-xs text-warning"><%= t("services.index.no_items") %></span>
    <% else %>
      <span class="block text-xs text-base-content/60 truncate"><%= set_items_preview(template) %></span>
    <% end %>
  <% end %>
  <span class="badge badge-ghost badge-sm hidden sm:inline-flex whitespace-nowrap"><%= template_summary(template, items: false) %></span>
  <%= link_to t("services.template.new_service"), new_service_set_path(from_template_id: template.id),
        class: "btn btn-ghost btn-sm", data: { role: "new-from-template" } %>
</li>
