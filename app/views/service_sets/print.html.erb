<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= @service_set.name %> — print</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      /* Standalone, print-first band chart. No admin shell, no screen padding —
         a compact lead sheet laid out the way worship chord charts print:
         tight line spacing, two columns, section labels, every part once. */
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: #fff; color: #111; }
      body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }

      /* Toolbar (screen only) */
      .print-bar {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        padding: 0.75rem 1rem; border-bottom: 1px solid #e3e6ea; background: #fff;
        position: sticky; top: 0;
      }
      .print-bar .title { font-weight: 700; }
      .print-bar .sub { color: #666; font-size: 0.85rem; font-weight: 400; margin-left: 0.5rem; }
      .print-bar a, .print-bar button {
        font: inherit; font-size: 0.9rem; padding: 0.35rem 0.8rem; border-radius: 0.4rem;
        border: 1px solid #c9ced6; background: #fff; color: #111; text-decoration: none; cursor: pointer;
      }
      .print-bar .primary { background: #1a56db; border-color: #1a56db; color: #fff; }
      .print-actions { display: flex; gap: 0.5rem; }

      /* The chart sheet */
      .sheet { padding: 1.25rem 1.5rem 2rem; max-width: 60rem; margin: 0 auto; }
      .sheet-head { margin-bottom: 0.75rem; }
      .sheet-head h1 { font-size: 1.25rem; margin: 0; }
      .sheet-head .meta { color: #555; font-size: 0.85rem; margin-top: 0.1rem; }

      /* Two columns so a whole service fits a page; a song never splits a column. */
      .chart { column-count: 2; column-gap: 1.75rem; }
      .song { break-inside: avoid; -webkit-column-break-inside: avoid; margin: 0 0 0.9rem; }

      .song-title { font-size: 1rem; font-weight: 800; margin: 0; }
      .song-key {
        display: inline-block; font-size: 0.7rem; font-weight: 700; color: #1a56db;
        border: 1px solid #c7d2fe; background: #eef2ff; border-radius: 0.35rem;
        padding: 0 0.35rem; margin-left: 0.4rem; vertical-align: middle;
      }
      .song-credits { color: #666; font-size: 0.7rem; margin: 0.05rem 0 0.25rem; }

      /* Chord-over-lyric float, compact. Chord sits above its syllable. */
      .musician-chart-section { margin: 0.2rem 0 0.4rem; }
      .musician-chart-section.is-replay { opacity: 0.9; }
      .musician-chart-label {
        font-size: 0.66rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase;
        color: #b45309; margin: 0.25rem 0 0;
      }
      .musician-chart-tag {
        margin-left: 0.4rem; font-size: 0.62rem; font-weight: 700; color: #666;
        background: #f1f3f5; border: 1px solid #e3e6ea; padding: 0 0.3rem; border-radius: 0.35rem;
        text-transform: lowercase;
      }
      .musician-chart-line {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        white-space: pre-wrap; font-size: 0.8rem; line-height: 1.15; padding-top: 1em;
      }
      .musician-chart-annotation { font-style: italic; color: #666; font-size: 0.75rem; }
      .musician-seg { position: relative; display: inline-block; white-space: pre; vertical-align: bottom; }
      .musician-chord {
        position: absolute; bottom: 100%; left: 0; font-weight: 700; line-height: 1;
        white-space: pre; padding-right: 0.5rem; color: #1a56db;
      }

      /* Text slides in the set */
      .slide { break-inside: avoid; -webkit-column-break-inside: avoid; margin: 0 0 0.9rem; }
      .slide-title { font-size: 0.95rem; font-weight: 800; margin: 0 0 0.15rem; }
      .slide-page { font-size: 0.62rem; font-weight: 700; color: #666; margin-left: 0.4rem; }
      .slide-body { font-size: 0.8rem; line-height: 1.25; }
      .slide-body p { margin: 0 0 0.3rem; }

      @media print {
        .print-bar { display: none !important; }
        .sheet { padding: 0; max-width: none; }
        @page { margin: 1cm; }
      }
    </style>
  </head>
  <body>
    <div class="print-bar">
      <div>
        <span class="title"><%= @service_set.name %></span>
        <span class="sub"><%= @service_set.service_date&.strftime("%A, %B %-d, %Y") || "No date set" %></span>
      </div>
      <div class="print-actions">
        <%= link_to "← Back", service_set_path(@service_set) %>
        <button type="button" class="primary" onclick="window.print()">Print</button>
      </div>
    </div>

    <div class="sheet">
      <div class="chart">
        <%#
          Group the flat row list into blocks: a :title starts a song block that
          collects the following :section rows; a :slide is its own block. This keeps
          the HTML balanced without open/close bookkeeping across the loop.
        %>
        <% blocks = [] %>
        <% @set_rows.each do |row| %>
          <% if row.kind == :title %>
            <% blocks << { kind: :song, title: row, sections: [] } %>
          <% elsif row.kind == :section %>
            <% blocks.last[:sections] << row if blocks.last && blocks.last[:kind] == :song %>
          <% elsif row.kind == :slide %>
            <% blocks << { kind: :slide, row: row } %>
          <% end %>
        <% end %>

        <% blocks.each do |block| %>
          <% if block[:kind] == :song %>
            <% t = block[:title] %>
            <div class="song">
              <h2 class="song-title">
                <%= t.song.title %>
                <% if t.displayed_key %><span class="song-key">Key <%= t.displayed_key %></span><% end %>
              </h2>
              <% credits = [ t.song.author, t.song.copyright_line, (t.song.ccli_song_number.present? ? "CCLI ##{t.song.ccli_song_number}" : nil) ].compact %>
              <% if credits.any? %><div class="song-credits"><%= credits.join(" · ") %></div><% end %>
              <% block[:sections].each do |s| %>
                <%= render "songs/musician_chart_section", section: s.section, projected: s.projected %>
              <% end %>
            </div>
          <% else %>
            <% r = block[:row] %>
            <div class="slide">
              <div class="slide-title"><%= r.slide.title.presence || "Untitled slide" %><% if r.slide.page_count > 1 %><span class="slide-page">page <%= r.page + 1 %> of <%= r.slide.page_count %></span><% end %></div>
              <div class="slide-body"><%= raw r.slide.rendered_html(r.page) %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <script>
      // Open straight into the print dialog, like a typical "Print" page.
      window.addEventListener("load", function () { setTimeout(function () { window.print(); }, 250); });
    </script>
  </body>
</html>
