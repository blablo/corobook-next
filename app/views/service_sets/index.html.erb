<div class="mx-auto mt-8 max-w-3xl p-4" data-role="sets-index">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold">Sets — <%= current_church.name %></h1>
    <%= link_to "New set", new_service_set_path, class: "btn btn-primary btn-sm" %>
  </div>

  <% if @service_sets.empty? %>
    <div class="card bg-base-100 border border-base-200">
      <div class="card-body items-center text-center text-sm text-base-content/60" data-role="empty">
        No sets yet.
      </div>
    </div>
  <% else %>
    <ul class="list bg-base-100 rounded-box border border-base-200">
      <% @service_sets.each do |set| %>
        <li class="list-row items-center" data-role="set-row">
          <%= link_to set.name, service_set_path(set), class: "link link-hover list-col-grow font-medium" %>
          <span class="text-sm text-base-content/60"><%= set.service_date %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
