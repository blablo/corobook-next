<div class="mx-auto mt-8 max-w-3xl">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold">Sets — <%= current_church.name %></h1>
    <%= link_to "New set", new_service_set_path, class: "rounded bg-slate-800 text-white px-3 py-2 text-sm" %>
  </div>

  <ul class="divide-y">
    <% @service_sets.each do |set| %>
      <li class="py-2 flex items-center justify-between">
        <%= link_to set.name, service_set_path(set), class: "underline" %>
        <span class="text-sm text-slate-500"><%= set.service_date %></span>
      </li>
    <% end %>
    <% if @service_sets.empty? %>
      <li class="py-2 text-sm text-slate-500">No sets yet.</li>
    <% end %>
  </ul>
</div>
