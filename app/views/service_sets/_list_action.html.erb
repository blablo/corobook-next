<%#
  A list row's button: Resume for the live service, Open for every other. Going live, adding
  items and filling slots happen on the service page (or from the Next service card). The column
  is a fixed width so the status badges beside it line up. Locals: set, active_session.
%>
<div class="flex shrink-0 justify-end sm:w-24">
  <% if active_session&.service_set_id == set.id %>
    <%= link_to t("services.index.resume"), operator_path(active_session),
          class: "btn btn-primary btn-sm", data: { role: "set-resume" } %>
  <% else %>
    <%= link_to t("services.index.open"), service_set_path(set),
          class: "btn btn-ghost btn-sm", data: { role: "set-open" } %>
  <% end %>
</div>
