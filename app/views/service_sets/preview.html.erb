<% content_for :title, t("services.preview.page_title", name: @service_set.name) %>

<div class="mx-auto my-6 max-w-3xl px-4 sm:px-6 musician-root musician-preview-page" data-role="set-preview">
  <%# ── Header (hidden when printing) ───────────────────────────── %>
  <header class="musician-topbar no-print">
    <div class="min-w-0">
      <div class="musician-setname" data-role="set-name"><%= @service_set.name %></div>
      <div class="text-xs text-base-content/60">
        <%= @service_set.service_date&.strftime("%A, %B %-d, %Y") || t("services.preview.no_date") %>
        · <%= t("services.preview.stops", count: @set_rows.count { |r| r.kind != :title }) %>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to t("services.preview.back"), service_set_path(@service_set), class: "btn btn-ghost btn-sm" %>
      <%= link_to t("services.preview.print"), print_service_set_path(@service_set, key: params[:key], semitones: params[:semitones], capo: params[:capo]),
            class: "btn btn-primary btn-sm", target: "_blank", rel: "noopener" %>
    </div>
  </header>

  <%# ── The whole set in order ──────────────────────────────────── %>
  <div class="musician-setlist" data-role="set-list">
    <% @set_rows.each do |row| %>
      <section class="musician-row" data-role="set-row"
               data-item-id="<%= row.item_id %>" data-section-index="<%= row.section_index %>">
        <% case row.kind %>
        <% when :title %>
          <div class="musician-chart-title" data-role="chart-title">
            <h2><%= row.song.title %></h2>
            <% if row.displayed_key %><span class="musician-chart-key" data-role="key-badge"><%= t("services.preview.key", key: row.displayed_key) %></span><% end %>
            <% credits = [ row.song.author, row.song.copyright_line, (row.song.ccli_song_number.present? ? "CCLI ##{row.song.ccli_song_number}" : nil) ].compact %>
            <% if credits.any? %>
              <div class="musician-chart-credits"><% credits.each do |c| %><div><%= c %></div><% end %></div>
            <% end %>
          </div>
        <% when :section %>
          <%= render "songs/musician_chart_section", section: row.section, projected: row.projected %>
        <% when :slide %>
          <div class="musician-chart-title" data-role="slide-title">
            <h2>
              <%= row.slide.title.presence || t("services.preview.untitled_slide") %>
              <% if row.slide.page_count > 1 %>
                <span class="musician-chart-key" data-role="slide-page"><%= t("services.preview.page_of", page: row.page + 1, total: row.slide.page_count) %></span>
              <% end %>
            </h2>
          </div>
          <%= render "text_slides/musician_slide", slide: row.slide, page: row.page %>
        <% end %>
      </section>
    <% end %>

    <% if @set_rows.empty? %>
      <p class="musician-empty" data-role="empty"><%= t("services.preview.empty") %></p>
    <% end %>
  </div>
</div>
