<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= t("services.print_order.page_title", name: @service_set.name) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      /* Standalone, print-first order of service (no admin shell): the items in order,
         numbered. A text slide prints its title and text; a song or an imported slide, its
         title only. The toolbar matches the band-chart print view. */
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: #fff; color: #111; }
      body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }

      /* Toolbar (screen only) */
      .print-bar {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        padding: 0.75rem 1rem; border-bottom: 1px solid #e3e6ea; background: #fff;
        position: sticky; top: 0;
      }
      .print-bar .title { font-weight: 700; }
      .print-bar a, .print-bar button {
        font: inherit; font-size: 0.9rem; padding: 0.35rem 0.8rem; border-radius: 0.4rem;
        border: 1px solid #c9ced6; background: #fff; color: #111; text-decoration: none; cursor: pointer;
      }
      .print-bar .primary { background: #1a56db; border-color: #1a56db; color: #fff; }
      .print-actions { display: flex; gap: 0.5rem; }

      /* The order */
      .sheet { padding: 1.5rem; max-width: 42rem; margin: 0 auto; }
      .sheet-head { margin-bottom: 0.5rem; padding-bottom: 0.75rem; border-bottom: 2px solid #111; }
      .sheet-head h1 { font-size: 1.4rem; margin: 0; }
      .sheet-head .meta { color: #555; font-size: 0.9rem; margin-top: 0.15rem; }

      .order { list-style: none; margin: 0; padding: 0; }
      .order li {
        display: grid; grid-template-columns: 1.75rem 1fr; gap: 0.5rem;
        padding: 0.6rem 0; border-bottom: 1px solid #e5e7eb;
        break-inside: avoid; -webkit-column-break-inside: avoid;
      }
      .order .n { color: #888; text-align: right; font-variant-numeric: tabular-nums; }
      .order .item-title { font-weight: 700; }
      .order .text { margin-top: 0.25rem; font-size: 0.9rem; line-height: 1.4; color: #333; }
      .order .text :is(p, ul, ol) { margin: 0 0 0.3rem; }
      .order .text :is(ul, ol) { padding-left: 1.25rem; }
      .order .text :is(h1, h2, h3, h4) { font-size: inherit; margin: 0 0 0.2rem; }
      .order .page + .page { margin-top: 0.5rem; }
      /* A countdown field has no live clock on paper: show what it counts to (10:30, or 5 min)
         instead of its 00:00 placeholder. */
      .order .text .slide-countdown { font-size: 0; }
      .order .text .slide-countdown[data-countdown-to-value]::after { content: attr(data-countdown-to-value); font-size: 0.9rem; }
      .order .text .slide-countdown[data-countdown-minutes-value]::after { content: attr(data-countdown-minutes-value) " min"; font-size: 0.9rem; }
      .empty { color: #666; padding: 1rem 0; }

      @media print {
        .print-bar { display: none !important; }
        .sheet { padding: 0; max-width: none; }
        @page { margin: 1.5cm; }
      }
    </style>
  </head>
  <body>
    <div class="print-bar">
      <span class="title"><%= t("services.print_order.heading") %></span>
      <div class="print-actions">
        <%= link_to t("services.print_order.back"), service_set_path(@service_set) %>
        <button type="button" class="primary" onclick="window.print()"><%= t("services.print_order.print") %></button>
      </div>
    </div>

    <div class="sheet" data-role="order-of-service">
      <div class="sheet-head">
        <h1><%= @service_set.name %></h1>
        <div class="meta"><%= @service_set.service_date ? l(@service_set.service_date, format: :weekday) : t("services.print_order.no_date") %></div>
      </div>

      <% if @items.empty? %>
        <p class="empty"><%= t("services.print_order.empty") %></p>
      <% else %>
        <ol class="order">
          <% @items.each_with_index do |item, i| %>
            <% slide = item.text_slide if item.item_type == "text_slide" %>
            <li data-role="order-item">
              <span class="n"><%= i + 1 %></span>
              <div>
                <div class="item-title" data-role="order-title">
                  <%= slide ? (slide.title.presence || t("services.print_order.untitled_slide")) : item.song.title %>
                </div>
                <% if slide && !slide.imported? %>
                  <div class="text" data-role="order-text">
                    <% slide.page_count.times do |page| %>
                      <div class="page"><%= raw slide.rendered_html(page) %></div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </li>
          <% end %>
        </ol>
      <% end %>
    </div>

    <script>
      // Open straight into the print dialog, like the band-chart print view.
      window.addEventListener("load", function () { setTimeout(function () { window.print(); }, 250); });
    </script>
  </body>
</html>
