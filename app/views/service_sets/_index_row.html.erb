<li class="list-row items-center hover:bg-base-200" data-role="set-row">
  <%= render "date_block", date: set.service_date %>
  <%= link_to service_set_path(set), class: "list-col-grow min-w-0" do %>
    <span class="flex items-center gap-2 min-w-0">
      <span class="font-medium truncate"><%= set.name %></span>
      <% if local_assigns[:next_service] %>
        <span class="badge badge-soft badge-primary badge-sm shrink-0" data-role="next-badge"><%= t("services.index.next") %></span>
      <% end %>
    </span>
    <% if set.set_items.empty? %>
      <span class="block text-xs text-warning"><%= t("services.index.no_items") %></span>
    <% else %>
      <span class="block text-xs text-base-content/60 truncate"><%= set_items_preview(set) %></span>
    <% end %>
  <% end %>
  <span class="badge badge-ghost badge-sm hidden sm:inline-flex whitespace-nowrap">
    <%= t("services.index.items", count: set.set_items.size) %>
  </span>
  <%# A fixed-width action column (wide enough for the longest label, e.g. "Llenar 12 espacios"),
      so the item badges line up whichever button a row has. %>
  <div class="flex shrink-0 justify-end sm:w-40">
    <%= render "live_action", set: set, active_session: active_session %>
  </div>
</li>
