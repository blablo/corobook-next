<%= form_with model: service_set, url: (service_set.persisted? ? service_set_path(service_set) : service_sets_path),
      class: "max-w-lg" do |f| %>
  <% if service_set.errors.any? %>
    <div class="alert alert-error mb-4 text-sm">
      <span><%= service_set.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="card bg-base-100 ring-1 ring-base-200">
    <div class="card-body gap-4">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Service date</legend>
        <%= f.date_field :service_date, class: "input input-bordered w-full",
              data: { role: "set-date" } %>
        <p class="label">Defaults to the next Sunday.</p>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Name</legend>
        <%= f.text_field :name, class: "input input-bordered w-full",
              data: { role: "set-name" } %>
        <p class="label">Defaults to the date — change it if you like.</p>
      </fieldset>

      <div class="flex items-center gap-3">
        <%= f.submit (service_set.persisted? ? "Save changes" : "Create set"), class: "btn btn-primary" %>
        <%= link_to "Cancel", (service_set.persisted? ? service_set_path(service_set) : service_sets_path), class: "btn btn-ghost" %>
      </div>
    </div>
  </div>

  <% unless service_set.persisted? %>
    <%# On a NEW set, keep the name mirroring the date until the user edits the name themselves. %>
    <script>
      (function () {
        const dateEl = document.querySelector("[data-role=set-date]")
        const nameEl = document.querySelector("[data-role=set-name]")
        if (!dateEl || !nameEl) return
        const fmt = (iso) => {
          if (!iso) return ""
          const d = new Date(iso + "T00:00:00")
          return d.toLocaleDateString(undefined, { weekday: "long", month: "short", day: "numeric" })
        }
        let autoName = nameEl.value === fmt(dateEl.value) || nameEl.value === ""
        nameEl.addEventListener("input", () => { autoName = false })
        dateEl.addEventListener("change", () => { if (autoName) nameEl.value = fmt(dateEl.value) })
      })()
    </script>
  <% end %>
<% end %>
