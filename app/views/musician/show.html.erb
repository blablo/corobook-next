<%# @session is nil on the permanent per-service link when the service isn't live: the chart
    still renders, without the live Now/Next bar or the current-row highlight. %>
<%= turbo_stream_from [ @session, :musician ] if @session %>
<div class="musician-root" data-theme="light" data-role="musician-root"
     data-controller="header-reveal<%= ' musician-follow' if @session %>">

  <%# ── Top bar: one slim line; it and the Now band slide away while reading down ── %>
  <div class="musician-topbar">
    <div class="musician-setname truncate min-w-0" data-role="set-name"><%= @service_set.name %></div>
    <div class="flex items-center gap-2 shrink-0 text-xs text-base-content/60">
      <% if @service_set.service_date %><span class="hidden sm:inline"><%= @service_set.service_date.strftime(t("live.musician.date_format")) %></span><% end %>
      <% if @session %>
        <span class="badge badge-soft badge-success badge-sm gap-1.5">
          <span class="status status-success animate-pulse" aria-hidden="true"></span><%= t("live.musician.live") %>
        </span>
      <% end %>
    </div>
  </div>

  <% unless @session %>
    <div role="status" class="musician-not-live alert alert-info alert-soft" data-role="not-live">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/></svg>
      <span><%= @service_set.service_date ? t("live.musician.not_live_dated", date: @service_set.service_date.strftime(t("live.musician.date_format"))) : t("live.musician.not_live") %></span>
    </div>
  <% else %>
  <%# ── Above the fold: what the projector is on NOW + a peek at NEXT ────
      Both live inside the frame the operator broadcast replaces, so they follow the projector. %>
  <div class="musician-nowbar" data-role="now-bar">
    <div class="musician-now">
      <%= render "live/musician_frame", session: @session,
            target_key: @target_key, semitones: @semitones, capo: @capo %>
    </div>
  </div>
  <% end %>

  <%# ── The whole set, in order, at this musician's key ───────────────── %>
  <div class="musician-setlist" data-role="set-list">
    <% last_item_id = nil %>
    <% @set_rows.each do |row| %>
      <% current = @session && musician_current_row?(row, @session) %>
      <section class="musician-row<%= ' is-current' if current %>"
               id="row-<%= row.item_id %>-<%= row.section_index %>"
               data-role="set-row"
               data-item-id="<%= row.item_id %>" data-section-index="<%= row.section_index %>"
               <%= 'data-current="true"'.html_safe if current %>>
        <% case row.kind %>
        <% when :title %>
          <div class="musician-chart-title" data-role="chart-title">
            <h2><%= row.song.title %></h2>
            <% if row.displayed_key %><span class="musician-chart-key" data-role="key-badge"><%= t("live.musician.key_badge", key: row.displayed_key) %></span><% end %>
            <% credits = [ row.song.author, row.song.copyright_line, (row.song.ccli_song_number.present? ? "CCLI ##{row.song.ccli_song_number}" : nil) ].compact %>
            <% if credits.any? %>
              <div class="musician-chart-credits"><% credits.each do |c| %><div><%= c %></div><% end %></div>
            <% end %>
          </div>
        <% when :section %>
          <%= render "songs/musician_chart_section", section: row.section, projected: row.projected %>
        <% when :slide %>
          <%= render "text_slides/musician_slide", slide: row.slide, page: row.page %>
        <% end %>
      </section>
    <% end %>

    <% if @set_rows.empty? %>
      <p class="musician-empty" data-role="empty"><%= t("live.musician.empty") %></p>
    <% end %>
  </div>
</div>
