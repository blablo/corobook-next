<%#
  Projector live frame. Locals: session. Carries position_version so the follower guard can drop
  stale/out-of-order frames (design §6.2). Blanked → black screen.
%>
<% frame = Corobook::LiveFrame.new(session) %>
<% proj = session.church.projector_settings %>
<%# The church's projection settings are for SONGS. A custom text slide carries its own look
    (background, text colour, font), set per slide in the slide editor. %>
<% song_style = frame.text_slide? ? "#{frame.item.projector_style};" : "#{proj.style};" %>
<%# preview: true renders a static copy (the operator's Next slide): no #live-frame id and no
    follower controller, so broadcasts and the version guard only ever touch the live frame. %>
<% preview = local_assigns.fetch(:preview, false) %>
<%# data-live-since: when this stop went live (ms), the start of a "for 5 minutes" countdown;
    data-server-now lets each browser correct its clock so every screen agrees. %>
<div <% unless preview %>id="live-frame" data-controller="follower" data-follower-version-value="<%= session.position_version %>"
     data-live-since="<%= (session.position_since.to_f * 1000).to_i %>" data-server-now="<%= (Time.current.to_f * 1000).to_i %>"<% end %>
     data-role="<%= preview ? 'projector-frame-preview' : 'projector-frame' %>" data-font-scale="<%= session.font_scale %>"
     style="--font-scale: <%= session.font_scale %>; <%= song_style %>"
     class="live-frame <%= 'is-blanked' if session.blanked %> <%= 'has-song-bg' if !session.blanked && !frame.text_slide? && proj.background_image? %>">
  <%# Song-wide background image (set in Song projection settings): a cover photo behind a dark
      scrim, shown for the title slide and lyric slides but NOT custom text slides (they carry
      their own background). Not shown when the stage is blanked. %>
  <% if !session.blanked && !frame.text_slide? && proj.background_image? %>
    <div class="projector-slide-bg" data-role="song-bg"
         style="background-image: url('<%= rails_blob_path(proj.background_image, only_path: true) %>');">
      <div class="projector-slide-scrim"></div>
    </div>
  <% end %>
  <% if session.blanked %>
    <div class="projector-blank" data-role="blank"></div>
  <% elsif frame.title_slide? %>
    <%= render "songs/projector_title", song: frame.item, show_credits: proj.show_credits? %>
  <% elsif frame.song? && frame.current_section %>
    <%= render "songs/projector_section",
          lines: frame.current_section_plain_lines,
          repeats: frame.current_repeat_marks,
          is_final_section: frame.final_chunk?,
          song: frame.item,
          church_license: session.church.ccli_license_number,
          show_credits: proj.show_credits?,
          font_size: proj.font_size,
          min_font_size: proj.min_font_size,
          song_key: "#{frame.item.id}-#{frame.item.updated_at.to_i}" %>
    <%# Every lyric slide of this song, invisible, so the fit controller can find the one size
        that fits all of them (one text size per song). %>
    <div class="projector-measure" data-role="fit-measure" aria-hidden="true">
      <% frame.song_slide_lines.each do |slide_lines| %>
        <div class="projector-lyrics" data-role="fit-measure-slide">
          <% slide_lines.each do |line| %><div class="projector-line"><%= line.presence || raw("&nbsp;") %></div><% end %>
        </div>
      <% end %>
    </div>
  <% elsif frame.text_slide? && frame.item.auto_advance? %>
    <%# Pages turn by themselves from when this stop went live. The Next preview has no such
        moment yet, so it plays from page load. %>
    <%= render "text_slides/projector_auto_pages", slide: frame.item, since: (preview ? nil : session.position_since) %>
  <% elsif frame.text_slide? %>
    <%= render "text_slides/projector_slide", slide: frame.item, page: session.current_section_index %>
  <% end %>
</div>
