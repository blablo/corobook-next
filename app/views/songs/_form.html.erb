<%= form_with model: song, data: { controller: "song-editor" } do |f| %>
  <% if song.errors.any? %>
    <div class="alert alert-error mb-4" data-role="song-errors">
      <span><%= song.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_20rem] gap-6 items-start">
  <div class="space-y-6 min-w-0">
  <%# ── Song details ─────────────────────────────────────────────── %>
  <div class="card card-border bg-base-100">
    <div class="card-body gap-4">
      <h2 class="card-title text-base"><%= t("songs.form.details") %></h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <fieldset class="fieldset">
          <%= f.label :title, t("songs.form.title_label"), class: "fieldset-legend" %>
          <%= f.text_field :title, class: "input w-full", placeholder: t("songs.form.title_placeholder") %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :author, t("songs.form.author_label"), class: "fieldset-legend" %>
          <%= f.text_field :author, class: "input w-full", placeholder: t("songs.form.author_placeholder") %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :song_key, t("songs.form.key_label"), class: "fieldset-legend" %>
          <%= f.select :song_key,
                options_for_select(%w[C C# D Eb E F F# G Ab A Bb B Am Bm Cm C#m Dm Em Fm F#m Gm G#m], song.song_key),
                { include_blank: "—" },
                class: "select w-full", data: { "song-editor-target": "keyField" } %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :capo, t("songs.form.capo_label"), class: "fieldset-legend" %>
          <%= f.number_field :capo, in: 0..11, class: "input w-full" %>
        </fieldset>
      </div>
    </div>
  </div>

  <%# ── Lyrics & chords (the editor) ─────────────────────────────── %>
  <div class="card card-border bg-base-100">
    <div class="card-body gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="card-title text-base flex-1"><%= t("songs.form.lyrics_chords") %></h2>
        <button type="button" class="btn btn-sm btn-outline gap-1" data-action="song-editor#openImport">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/></svg>
          <%= t("songs.form.import") %>
        </button>
        <%# mode toggle %>
        <div class="join">
          <button type="button" class="btn btn-sm join-item btn-active" data-song-editor-target="visualBtn"
                  data-action="song-editor#showVisual"><%= t("songs.form.visual") %></button>
          <button type="button" class="btn btn-sm join-item" data-song-editor-target="advancedBtn"
                  data-action="song-editor#showAdvanced"><%= t("songs.form.advanced") %></button>
        </div>
      </div>

      <%# Import modal: paste chords-over-lyrics text (DaisyUI dialog) %>
      <dialog class="modal" data-song-editor-target="importModal">
        <div class="modal-box max-w-2xl">
          <h3 class="text-lg font-bold"><%= t("songs.form.import_modal.title") %></h3>
          <p class="text-sm text-base-content/60 mt-1"><%= t("songs.form.import_modal.description_html", verse: tag.code("VERSE 1"), chorus: tag.code("CHORUS")) %></p>
          <textarea rows="12" class="textarea w-full font-mono text-sm mt-3" data-song-editor-target="importText"
                    placeholder="VERSE 1&#10;C               F  G  C&#10;¡Al mundo paz, nació Jesús!&#10;..."></textarea>
          <label class="flex items-center gap-2 text-sm mt-2">
            <input type="checkbox" class="checkbox checkbox-sm" data-song-editor-target="importReplace" checked>
            <%= t("songs.form.import_modal.replace") %>
          </label>
          <div class="modal-action">
            <button type="button" class="btn btn-ghost btn-sm" data-action="song-editor#closeImport"><%= t("songs.form.import_modal.cancel") %></button>
            <button type="button" class="btn btn-primary btn-sm" data-action="song-editor#runImport"><%= t("songs.form.import_modal.import") %></button>
          </div>
        </div>
        <button type="button" class="modal-backdrop" aria-label="<%= t('songs.form.import_modal.close') %>" data-action="song-editor#closeImport"></button>
      </dialog>

      <%# Sections, then the add-section bar beneath them (new sections are appended at the end). %>
      <div class="flex flex-col gap-3" data-song-editor-target="visual">
        <p class="flex items-start gap-2 text-sm text-base-content/60">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0 mt-0.5 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/></svg>
          <span><%= t("songs.form.chord_hint") %></span>
        </p>
        <div class="w-full" data-role="sections"></div>
        <div class="flex flex-wrap items-center gap-2 rounded-box border border-dashed border-base-300 px-3 py-2">
          <span class="text-sm font-medium mr-1"><%= t("songs.form.add_section") %></span>
          <button type="button" class="btn btn-sm btn-soft btn-primary" data-action="song-editor#addSection" data-kind="verse"><%= t("songs.form.section.verse") %></button>
          <button type="button" class="btn btn-sm btn-soft btn-primary" data-action="song-editor#addSection" data-kind="chorus"><%= t("songs.form.section.chorus") %></button>
          <button type="button" class="btn btn-sm btn-soft btn-primary" data-action="song-editor#addSection" data-kind="bridge"><%= t("songs.form.section.bridge") %></button>
          <details class="dropdown">
            <summary class="btn btn-sm btn-ghost"><%= t("songs.form.more_sections") %>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
            </summary>
            <ul class="dropdown-content menu bg-base-100 rounded-box border border-base-300 shadow z-20 w-48 p-2">
              <li><button type="button" data-action="song-editor#addSection" data-kind="verse" data-label="Pre-chorus" onclick="this.closest('details').removeAttribute('open')"><%= t("songs.form.section.pre_chorus") %></button></li>
              <li><button type="button" data-action="song-editor#addSection" data-kind="verse" data-label="Intro" onclick="this.closest('details').removeAttribute('open')"><%= t("songs.form.section.intro") %></button></li>
              <li><button type="button" data-action="song-editor#addSection" data-kind="verse" data-label="Solo" onclick="this.closest('details').removeAttribute('open')"><%= t("songs.form.section.solo") %></button></li>
              <li><button type="button" data-action="song-editor#addSection" data-kind="verse" data-label="Instrumental" onclick="this.closest('details').removeAttribute('open')"><%= t("songs.form.section.instrumental") %></button></li>
              <li><button type="button" data-action="song-editor#addSection" data-kind="verse" data-label="Outro" onclick="this.closest('details').removeAttribute('open')"><%= t("songs.form.section.outro") %></button></li>
            </ul>
          </details>
        </div>
      </div>

      <%# advanced raw ChordPro — nameless; mirrors into the canonical hidden field via the controller %>
      <label for="advanced_chordpro" class="sr-only"><%= t("songs.form.chordpro_source") %></label>
      <textarea id="advanced_chordpro" rows="16" class="textarea w-full font-mono text-sm hidden"
                data-song-editor-target="advanced"><%= song.chordpro_source %></textarea>

      <%# canonical source — the ONLY field named song[chordpro_source]; what the server parses %>
      <%= f.hidden_field :chordpro_source, data: { "song-editor-target": "source" } %>

      <% warnings = parse_warnings(song) %>
      <% if warnings.any? %>
        <div class="alert alert-warning" data-role="parse-warning">
          <div><% warnings.each { |w| %><div><%= w %></div><% } %></div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Arrangement (advanced, collapsed) ────────────────────────── %>
  <div class="collapse collapse-arrow border border-base-300 bg-base-100" data-song-editor-target="arrangeWrap">
    <input type="checkbox" />
    <div class="collapse-title font-semibold"><%= t("songs.form.arrangement.title") %></div>
    <div class="collapse-content">
      <p class="text-sm text-base-content/60 mb-3"><%= t("songs.form.arrangement.help") %></p>

      <div class="text-sm font-medium mb-1"><%= t("songs.form.arrangement.available") %></div>
      <div class="flex flex-wrap gap-2 mb-4" data-song-editor-target="arrangeAvail"></div>

      <div class="text-sm font-medium mb-1"><%= t("songs.form.arrangement.play_order") %></div>
      <div class="flex flex-col divide-y divide-base-300 rounded-box border border-base-300 overflow-hidden" data-song-editor-target="arrangeOrder"></div>

      <%# canonical field the server parses; kept in sync by the controller %>
      <%= hidden_field_tag "song[arrangement_text]", (song.arrangement || []).join("\n"),
            data: { "song-editor-target": "arrangeField", role: "arrangement" } %>
    </div>
  </div>

  </div>

  <%# ── Side column: credits + actions, sticky so Save stays in view while editing lyrics ── %>
  <aside class="space-y-6 lg:sticky lg:top-20">
  <%# ── Copyright & CCLI ─────────────────────────────────────────── %>
  <div class="card card-border bg-base-100">
    <div class="card-body gap-4">
      <h2 class="card-title text-base"><%= t("songs.form.copyright_ccli") %></h2>
      <fieldset class="fieldset">
        <%= f.label :copyright_line, t("songs.form.copyright_line_label"), class: "fieldset-legend" %>
        <%= f.text_field :copyright_line, class: "input w-full", placeholder: t("songs.form.copyright_line_placeholder") %>
      </fieldset>
      <div class="grid grid-cols-1 gap-4">
        <fieldset class="fieldset">
          <%= f.label :ccli_song_number, t("songs.form.ccli_song_number_label"), class: "fieldset-legend" %>
          <%= f.number_field :ccli_song_number, class: "input w-full" %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :copyright_status, t("songs.form.status_label"), class: "fieldset-legend" %>
          <%= f.select :copyright_status, Song.copyright_statuses.keys.map { |k| [k.humanize, k] },
                {}, class: "select w-full" %>
        </fieldset>
      </div>
    </div>
  </div>

  <div class="card card-border bg-base-100">
    <div class="card-body">
      <div class="card-actions justify-end">
        <%= link_to t("songs.form.cancel"), (song.persisted? ? song_path(song) : songs_path), class: "btn btn-ghost" %>
        <%= f.submit (song.persisted? ? t("songs.form.save") : t("songs.form.create")), class: "btn btn-primary" %>
      </div>
    </div>
  </div>
  </aside>
  </div>
<% end %>
