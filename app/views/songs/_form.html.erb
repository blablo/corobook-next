<%= form_with model: song, data: { controller: "song-editor" } do |f| %>
  <% if song.errors.any? %>
    <div class="alert alert-error mb-4" data-role="song-errors">
      <span><%= song.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <%# ── Song details ─────────────────────────────────────────────── %>
  <div class="card bg-base-100 ring-1 ring-base-200 mb-6">
    <div class="card-body gap-4">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/50">Song details</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <fieldset class="fieldset">
          <%= f.label :title, "Title", class: "fieldset-legend" %>
          <%= f.text_field :title, class: "input input-bordered w-full", placeholder: "Song title" %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :author, "Author", class: "fieldset-legend" %>
          <%= f.text_field :author, class: "input input-bordered w-full", placeholder: "Author" %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :song_key, "Key", class: "fieldset-legend" %>
          <%= f.select :song_key,
                options_for_select(%w[C C# D Eb E F F# G Ab A Bb B Am Bm Cm C#m Dm Em Fm F#m Gm G#m], song.song_key),
                { include_blank: "—" },
                class: "select select-bordered w-full", data: { "song-editor-target": "keyField" } %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :capo, "Capo", class: "fieldset-legend" %>
          <%= f.number_field :capo, in: 0..11, class: "input input-bordered w-full" %>
        </fieldset>
      </div>
    </div>
  </div>

  <%# ── Lyrics & chords (the editor) ─────────────────────────────── %>
  <div class="card bg-base-100 ring-1 ring-base-200 mb-6">
    <div class="card-body gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/50 flex-1">Lyrics &amp; chords</h2>
        <button type="button" class="btn btn-sm btn-outline gap-1" data-action="song-editor#openImport">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/></svg>
          Import
        </button>
        <%# mode toggle %>
        <div class="join">
          <button type="button" class="btn btn-sm join-item btn-active" data-song-editor-target="visualBtn"
                  data-action="song-editor#showVisual">Visual</button>
          <button type="button" class="btn btn-sm join-item" data-song-editor-target="advancedBtn"
                  data-action="song-editor#showAdvanced">Advanced (ChordPro)</button>
        </div>
      </div>

      <%# Import modal: paste chords-over-lyrics text (DaisyUI dialog) %>
      <dialog class="modal" data-song-editor-target="importModal">
        <div class="modal-box max-w-2xl">
          <h3 class="text-lg font-bold">Import song</h3>
          <p class="text-sm text-base-content/60 mt-1">Paste chords-over-lyrics text (chord lines above lyric lines, with section headers like <code>VERSE 1</code> / <code>CHORUS</code>). We'll convert it automatically.</p>
          <textarea rows="12" class="textarea textarea-bordered w-full font-mono text-sm mt-3" data-song-editor-target="importText"
                    placeholder="VERSE 1&#10;C               F  G  C&#10;¡Al mundo paz, nació Jesús!&#10;..."></textarea>
          <label class="flex items-center gap-2 text-sm mt-2">
            <input type="checkbox" class="checkbox checkbox-sm" data-song-editor-target="importReplace" checked>
            Replace existing sections
          </label>
          <div class="modal-action">
            <button type="button" class="btn btn-ghost btn-sm" data-action="song-editor#closeImport">Cancel</button>
            <button type="button" class="btn btn-primary btn-sm" data-action="song-editor#runImport">Import</button>
          </div>
        </div>
        <button type="button" class="modal-backdrop" aria-label="Close" data-action="song-editor#closeImport"></button>
      </dialog>

      <%# add-section buttons %>
      <div class="flex flex-wrap gap-2" data-song-editor-target="visual">
        <div class="flex flex-wrap gap-2 mb-1">
          <span class="text-sm text-base-content/60 self-center mr-1">Add section:</span>
          <button type="button" class="btn btn-sm btn-outline" data-action="song-editor#addSection" data-kind="verse">+ Verse</button>
          <button type="button" class="btn btn-sm btn-outline" data-action="song-editor#addSection" data-kind="chorus">+ Chorus</button>
          <button type="button" class="btn btn-sm btn-outline" data-action="song-editor#addSection" data-kind="bridge">+ Bridge</button>
        </div>
        <p class="text-xs text-base-content/50 w-full">Type lyrics on the line. To add a chord, click the strip just above a line. Click a chord to change or remove it.</p>
        <div class="w-full mt-1" data-role="sections"></div>
      </div>

      <%# advanced raw ChordPro — nameless; mirrors into the canonical hidden field via the controller %>
      <label for="advanced_chordpro" class="sr-only">ChordPro source</label>
      <textarea id="advanced_chordpro" rows="16" class="textarea textarea-bordered w-full font-mono text-sm hidden"
                data-song-editor-target="advanced"><%= song.chordpro_source %></textarea>

      <%# canonical source — the ONLY field named song[chordpro_source]; what the server parses %>
      <%= f.hidden_field :chordpro_source, data: { "song-editor-target": "source" } %>

      <% warnings = parse_warnings(song) %>
      <% if warnings.any? %>
        <div class="alert alert-warning" data-role="parse-warning">
          <div><% warnings.each { |w| %><div><%= w %></div><% } %></div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Copyright & CCLI ─────────────────────────────────────────── %>
  <div class="card bg-base-100 ring-1 ring-base-200 mb-6">
    <div class="card-body gap-4">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/50">Copyright &amp; CCLI</h2>
      <fieldset class="fieldset">
        <%= f.label :copyright_line, "Copyright line", class: "fieldset-legend" %>
        <%= f.text_field :copyright_line, class: "input input-bordered w-full", placeholder: "© 2001 Author / Publisher" %>
      </fieldset>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <fieldset class="fieldset">
          <%= f.label :ccli_song_number, "CCLI song number", class: "fieldset-legend" %>
          <%= f.number_field :ccli_song_number, class: "input input-bordered w-full" %>
        </fieldset>
        <fieldset class="fieldset">
          <%= f.label :copyright_status, "Status", class: "fieldset-legend" %>
          <%= f.select :copyright_status, Song.copyright_statuses.keys.map { |k| [k.humanize, k] },
                {}, class: "select select-bordered w-full" %>
        </fieldset>
      </div>
    </div>
  </div>

  <%# ── Arrangement (advanced, collapsed) ────────────────────────── %>
  <div class="collapse collapse-arrow bg-base-100 ring-1 ring-base-200 mb-6" data-song-editor-target="arrangeWrap">
    <input type="checkbox" />
    <div class="collapse-title text-sm font-semibold text-base-content/70">Arrangement order (optional)</div>
    <div class="collapse-content">
      <p class="text-xs text-base-content/50 mb-2">Click a section to add it to the play order. Drag or use the arrows to reorder; ✕ to remove. Reuse a section (e.g. a chorus) as many times as you like. Leave empty to play in section order.</p>

      <div class="text-xs font-semibold uppercase tracking-wide text-base-content/40 mb-1">Available sections</div>
      <div class="flex flex-wrap gap-2 mb-4" data-song-editor-target="arrangeAvail"></div>

      <div class="text-xs font-semibold uppercase tracking-wide text-base-content/40 mb-1">Play order</div>
      <div class="flex flex-col gap-1 min-h-[2.5rem] rounded-lg ring-1 ring-base-200 bg-base-200/30 p-2" data-song-editor-target="arrangeOrder"></div>

      <%# canonical field the server parses; kept in sync by the controller %>
      <%= hidden_field_tag "song[arrangement_text]", (song.arrangement || []).join("\n"),
            data: { "song-editor-target": "arrangeField", role: "arrangement" } %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit (song.persisted? ? "Save changes" : "Create song"), class: "btn btn-primary" %>
    <%= link_to "Cancel", (song.persisted? ? song_path(song) : songs_path), class: "btn btn-ghost" %>
  </div>
<% end %>
