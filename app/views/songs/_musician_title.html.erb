<%#
  Musician/operator TITLE slide for a song (the first stop before its lyrics). Locals: song.
%>
<div class="musician-title" data-role="musician-title">
  <h2 class="text-xl font-bold" data-role="title"><%= song.title %></h2>
  <% credits = [] %>
  <% credits << song.author if song.author.present? %>
  <% credits << song.copyright_line if song.copyright_line.present? %>
  <% credits << "CCLI ##{song.ccli_song_number}" if song.ccli_song_number.present? %>
  <% if credits.any? %>
    <div class="mt-2 text-sm text-white/60" data-role="title-credits">
      <% credits.each do |line| %><div><%= line %></div><% end %>
    </div>
  <% end %>
</div>
