<%#
  Projector rendering of the CURRENT lyric slide (Req 3.1, 3.2, 9.4).
  Locals:
    lines             - pre-resolved plain lyric lines for this slide (by_section = whole section,
                        by_lines = the current N-line chunk). Falls back to section_plain_lines(section).
    is_final_section  - true on the final slide of the song (shows the copyright notice).
    song, church_license
    show_credits      - whether the copyright/licensing notice may render (church setting; default true).
    font_size         - fixed lyric size as % of screen height (church setting); 0 = auto-fit.
    show_editor_warnings (default false).
%>
<% show_editor_warnings = local_assigns.fetch(:show_editor_warnings, false) %>
<% show_credits = local_assigns.fetch(:show_credits, true) %>
<% lines = local_assigns[:lines] || Corobook::ChordPro::Transform.section_plain_lines(section) %>
<% notice = Corobook::CopyrightNotice.for(song, church_license: church_license) %>

<div class="projector-section" data-controller="fit" data-fit-fixed-value="<%= local_assigns.fetch(:font_size, 0).to_i %>">
  <div data-fit-target="content" class="projector-lyrics" data-role="projector-lyrics">
    <% lines.each do |line| %>
      <div class="projector-line"><%= line.presence || raw("&nbsp;") %></div>
    <% end %>
  </div>

  <% if show_credits && is_final_section && notice.show? %>
    <p class="projector-copyright" data-role="copyright-notice"><%= notice.text %></p>
  <% end %>
</div>

<% if show_editor_warnings && notice.warn? %>
  <div class="alert alert-warning text-sm mt-2" data-role="copyright-warning">
    <%= notice.warning %>
  </div>
<% end %>
