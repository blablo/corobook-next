<div class="space-y-6" data-role="song-sheet" data-controller="autoscroll">
  <%# ── Header ──────────────────────────────────────────────────── %>
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
      <h1 class="text-2xl sm:text-3xl font-semibold leading-tight truncate"><%= @song.title %></h1>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <% if @song.author.present? %>
          <span class="text-base-content/60"><%= @song.author %></span>
        <% end %>
        <% if @displayed_key.present? %>
          <span class="badge badge-soft badge-primary font-mono" data-role="key-badge"><%= t("songs.show.key") %> <%= @displayed_key %></span>
        <% end %>
        <% if @musician_capo.to_i.positive? %>
          <span class="badge badge-ghost" data-role="capo-badge"><%= t("songs.show.capo") %> <%= @musician_capo %></span>
        <% end %>
      </div>
    </div>
    <% if can_edit? %>
      <%= link_to edit_song_path(@song), class: "btn btn-ghost no-print" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/></svg>
        <%= t("songs.show.edit") %>
      <% end %>
    <% end %>
  </header>

  <% warnings = parse_warnings(@song) %>
  <% if warnings.any? && can_edit? %>
    <div role="alert" class="alert alert-warning" data-role="parse-warning">
      <div><% warnings.each { |w| %><div><%= w %></div><% } %></div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_18rem] gap-6 items-start">
    <%# ── Chord sheet, in play order ──────────────────────────────── %>
    <section class="card card-border bg-base-100 min-w-0">
      <div class="card-body gap-5 p-4 sm:p-6">
        <div class="flex flex-col gap-3 sm:gap-6 min-w-0" data-role="musician-preview">
          <% @ordered_sections.each do |section| %>
            <%= render "sheet_section", section: section %>
          <% end %>
        </div>

        <% notice = Corobook::CopyrightNotice.for(@song, church_license: current_church.ccli_license_number) %>
        <% if notice.show? %>
          <footer class="pt-4 border-t border-base-300">
            <p class="text-xs text-base-content/60 leading-relaxed" data-role="copyright-notice"><%= notice.text %></p>
          </footer>
        <% end %>
      </div>
    </section>

    <%# ── Details ─────────────────────────────────────────────────── %>
    <aside class="space-y-4 lg:sticky lg:top-20 no-print">
      <% if can_edit? && notice.warn? %>
        <div role="alert" class="alert alert-warning" data-role="copyright-warning"><%= notice.warning %></div>
      <% end %>

      <section class="card card-border bg-base-100">
        <div class="card-body gap-4">
          <h2 class="card-title text-base"><%= t("songs.show.details") %></h2>
          <dl class="space-y-3">
            <% if @song.author.present? %>
              <div><dt class="text-xs text-base-content/60"><%= t("songs.show.author") %></dt><dd><%= @song.author %></dd></div>
            <% end %>
            <% if @song.song_key.present? %>
              <div><dt class="text-xs text-base-content/60"><%= t("songs.show.original_key") %></dt><dd class="font-mono"><%= @song.song_key %></dd></div>
            <% end %>
            <% if @song.ccli_song_number.present? %>
              <div><dt class="text-xs text-base-content/60"><%= t("songs.show.ccli_number") %></dt><dd class="font-mono"><%= @song.ccli_song_number %></dd></div>
            <% end %>
            <% if @song.copyright_line.present? %>
              <div><dt class="text-xs text-base-content/60"><%= t("songs.show.copyright") %></dt><dd><%= @song.copyright_line %></dd></div>
            <% end %>
            <div>
              <dt class="text-xs text-base-content/60"><%= t("songs.show.last_used") %></dt>
              <dd data-role="last-used">
                <% if @last_service %>
                  <%= link_to @last_service.name, service_set_path(@last_service), class: "link link-hover" %>
                <% else %>
                  <%= t("songs.index.never_used") %>
                <% end %>
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <% if @song.arrangement.present? %>
        <section class="card card-border bg-base-100" data-role="song-flow">
          <div class="card-body gap-3">
            <h2 class="card-title text-base"><%= t("songs.show.flow") %></h2>
            <ol class="flex flex-wrap gap-1.5">
              <% @song.arrangement.each do |label| %>
                <li class="badge badge-ghost"><%= label %></li>
              <% end %>
            </ol>
          </div>
        </section>
      <% end %>
    </aside>
  </div>

  <%# ── Hands-free auto-scroll (teleprompter) ───────────────────────
      A floating control so a player can let the sheet scroll itself instead of swiping.
      Play/pause toggles window auto-scroll; the slider sets the speed (persisted). Any
      manual scroll/touch/arrow pauses it. Hidden from print. %>
  <div class="autoscroll-dock" data-role="autoscroll-dock" role="group" aria-label="<%= t('songs.show.autoscroll.group') %>">
    <button type="button" class="btn btn-primary btn-circle shadow-lg"
            data-autoscroll-target="toggle" data-action="autoscroll#toggle"
            aria-pressed="false" aria-label="<%= t('songs.show.autoscroll.play') %>" title="<%= t('songs.show.autoscroll.title') %>">
      <svg data-autoscroll-icon="play" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      <svg data-autoscroll-icon="pause" class="w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
    </button>
    <div class="autoscroll-speed">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12l4-4M5 12l4 4"/></svg>
      <input type="range" min="1" max="10" step="1" value="3" class="range range-primary range-xs"
             data-autoscroll-target="speed" data-action="input->autoscroll#changeSpeed"
             aria-label="<%= t('songs.show.autoscroll.speed') %>" />
      <span class="autoscroll-speed-label" data-autoscroll-target="speedLabel">×3</span>
    </div>
  </div>
</div>
