<div class="mx-auto my-8 max-w-3xl px-4 sm:px-6" data-role="song-sheet">
  <%# ── Header band ─────────────────────────────────────────────── %>
  <header class="mb-6 pb-5 border-b border-base-300">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h1 class="text-3xl sm:text-4xl font-bold leading-tight tracking-tight truncate"><%= @song.title %></h1>
        <% if @song.author.present? %>
          <p class="mt-1 text-base-content/60"><%= @song.author %></p>
        <% end %>
      </div>
      <% if can_edit? %>
        <%= link_to edit_song_path(@song), class: "btn btn-ghost btn-sm shrink-0 gap-1" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          Edit
        <% end %>
      <% end %>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <% if @displayed_key.present? %>
        <span class="inline-flex items-center gap-1 rounded-md bg-primary/10 text-primary px-2.5 py-1 text-xs font-semibold" data-role="key-badge">Key <%= @displayed_key %></span>
      <% end %>
      <% if @musician_capo.to_i.positive? %>
        <span class="inline-flex items-center gap-1 rounded-md bg-base-200 text-base-content/70 px-2.5 py-1 text-xs font-semibold" data-role="capo-badge">Capo <%= @musician_capo %></span>
      <% end %>
      <% if @song.ccli_song_number.present? %>
        <span class="inline-flex items-center gap-1 rounded-md bg-base-200 text-base-content/70 px-2.5 py-1 text-xs font-semibold">CCLI #<%= @song.ccli_song_number %></span>
      <% end %>
    </div>
  </header>

  <% warnings = parse_warnings(@song) %>
  <% if warnings.any? && can_edit? %>
    <div class="alert alert-warning mb-5 text-sm" data-role="parse-warning">
      <div><% warnings.each { |w| %><div><%= w %></div><% } %></div>
    </div>
  <% end %>

  <%# ── Chord sheet, in play order ──────────────────────────────── %>
  <div class="flex flex-col gap-6 min-w-0" data-role="musician-preview">
    <% @ordered_sections.each do |section| %>
      <%= render "sheet_section", section: section %>
    <% end %>
  </div>

  <% notice = Corobook::CopyrightNotice.for(@song, church_license: current_church.ccli_license_number) %>
  <% if notice.show? %>
    <footer class="mt-8 pt-4 border-t border-base-300">
      <p class="text-xs text-base-content/50 leading-relaxed" data-role="copyright-notice"><%= notice.text %></p>
    </footer>
  <% end %>
  <% if can_edit? && notice.warn? %>
    <p class="alert alert-warning text-sm mt-4" data-role="copyright-warning"><%= notice.warning %></p>
  <% end %>
</div>
