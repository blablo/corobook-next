<div class="mx-auto mt-8 max-w-3xl px-4 sm:px-6" data-role="song-sheet">
  <%# ── Header ──────────────────────────────────────────────────── %>
  <div class="flex items-start justify-between gap-4 mb-1">
    <h1 class="text-3xl sm:text-4xl font-bold leading-tight"><%= @song.title %></h1>
    <% if can_edit? %>
      <%= link_to "Edit", edit_song_path(@song), class: "btn btn-ghost btn-sm shrink-0" %>
    <% end %>
  </div>

  <% if @song.author.present? %>
    <p class="text-base-content/70 mb-1"><span class="font-semibold">Grupo:</span> <%= @song.author %></p>
  <% end %>

  <% if @song.arrangement.present? %>
    <p class="text-sm mb-5" data-role="arrangement">
      <span class="font-semibold">Order:</span> <%= @song.arrangement.join(", ") %>
    </p>
  <% end %>

  <% warnings = parse_warnings(@song) %>
  <% if warnings.any? && can_edit? %>
    <div class="alert alert-warning mb-4 text-sm" data-role="parse-warning">
      <div><% warnings.each { |w| %><div><%= w %></div><% } %></div>
    </div>
  <% end %>

  <%# ── Chord sheet, in play order ──────────────────────────────── %>
  <div class="flex flex-col gap-5" data-role="musician-preview">
    <p class="text-sm text-base-content/60 flex flex-wrap gap-x-3 gap-y-0.5 -mb-1">
      <% if @displayed_key.present? %><span class="badge badge-ghost badge-sm" data-role="key-badge">Key <%= @displayed_key %></span><% end %>
      <% if @musician_capo.to_i.positive? %><span class="badge badge-ghost badge-sm" data-role="capo-badge">Capo <%= @musician_capo %></span><% end %>
      <% if @song.ccli_song_number.present? %><span class="badge badge-ghost badge-sm">CCLI #<%= @song.ccli_song_number %></span><% end %>
    </p>
    <% @ordered_sections.each do |section| %>
      <%= render "sheet_section", section: section %>
    <% end %>
  </div>

  <% notice = Corobook::CopyrightNotice.for(@song, church_license: current_church.ccli_license_number) %>
  <% if notice.show? %>
    <p class="text-xs text-base-content/50 mt-6" data-role="copyright-notice"><%= notice.text %></p>
  <% end %>
  <% if can_edit? && notice.warn? %>
    <p class="alert alert-warning text-sm mt-4" data-role="copyright-warning"><%= notice.warning %></p>
  <% end %>
</div>
