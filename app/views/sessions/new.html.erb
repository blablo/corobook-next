<div class="mx-auto mt-16 max-w-sm px-4">
  <h1 class="text-2xl font-bold mb-6">Sign in</h1>

  <% if signed_in? %>
    <p class="mb-4 text-sm" data-role="signed-in">
      Signed in as <%= current_user.email %> — <%= current_church.name %>.
    </p>
    <%= button_to "Sign out", logout_path, method: :delete, class: "btn btn-ghost btn-sm" %>
  <% else %>
    <%= form_with url: login_path, method: :post do |f| %>
      <% if subdomain_church %>
        <p class="mb-4 text-sm text-base-content/70" data-role="subdomain-church">
          Signing in to <span class="font-semibold"><%= subdomain_church.name %></span>.
        </p>
      <% else %>
        <fieldset class="fieldset">
          <%= f.label :church_id, "Church", class: "fieldset-legend" %>
          <%= f.collection_select :church_id, @churches, :id, :name, {}, class: "select select-bordered w-full" %>
        </fieldset>
      <% end %>
      <fieldset class="fieldset">
        <%= f.label :email, class: "fieldset-legend" %>
        <%= f.email_field :email, autocomplete: "email", class: "input input-bordered w-full" %>
      </fieldset>
      <fieldset class="fieldset mb-4">
        <%= f.label :password, class: "fieldset-legend" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
      </fieldset>
      <%= f.submit "Sign in", class: "btn btn-primary w-full" %>
    <% end %>
  <% end %>
</div>
