<%#
  A follow link's QR code under its title, as a button: phones scan it, clicking copies the link.
  A hint beside the title says "Copy" on hover, then "Copied" (clipboard sets data-copied
  meanwhile). It sits outside the code, so it never blocks a scan.
  Locals: url, title, role (data-role), large (sized for the Enlarge dialog).
%>
<% large = local_assigns[:large] %>
<button type="button" title="<%= url %>" aria-label="<%= t("live.operator.copy_join", name: title) %>"
        class="group flex flex-col gap-1.5 rounded-box p-2 text-left cursor-pointer hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        data-controller="clipboard" data-clipboard-text-value="<%= url %>" data-clipboard-done-value="✓ <%= t("live.operator.copied") %>"
        data-action="clipboard#copy" data-role="<%= role %>" data-url="<%= url %>">
  <span class="flex items-center justify-between gap-3">
    <span class="font-semibold <%= "text-lg" if large %>"><%= title %></span>
    <%# DaisyUI's colours come from its vendored CSS, which has no group-* variants, so these
        use its colour variables directly. %>
    <span class="text-xs text-primary opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 group-data-[copied]:opacity-100 group-data-[copied]:text-[var(--color-success)]"
          data-clipboard-target="label"><%= t("live.operator.copy") %></span>
  </span>
  <span class="block rounded-box border border-base-300 bg-white group-hover:border-[var(--color-primary)] group-data-[copied]:border-[var(--color-success)] <%= large ? "p-3 w-[min(24rem,80vw,65dvh)] [&_svg]:size-full" : "p-2" %>"><%= qr_svg(url, size: large ? 384 : 112) %></span>
</button>
