<div class="mx-auto mt-8 max-w-4xl" data-role="operator" data-controller="operator-clicker">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold"><%= @session.service_set.name %></h1>
    <span class="text-xs rounded px-2 py-0.5 <%= @session.active? ? 'bg-green-200 text-green-900' : 'bg-slate-300 text-slate-700' %>"
          data-role="live-indicator"><%= @session.active? ? "LIVE" : "ENDED" %></span>
  </div>

  <div class="flex gap-2 mb-4" data-role="operator-controls">
    <%= button_to "← Back", operator_back_path(@session), method: :patch,
          form: { data: { turbo: false, "operator-clicker-target": "back" } }, class: "rounded border px-3 py-2" %>
    <%= button_to "Next →", operator_advance_path(@session), method: :patch,
          form: { data: { turbo: false, "operator-clicker-target": "next" } }, class: "rounded bg-slate-800 text-white px-3 py-2" %>
    <%= button_to (@session.blanked ? "Unblank" : "Blank"), operator_blank_path(@session), method: :patch,
          form: { data: { turbo: false, "operator-clicker-target": "blank" } }, class: "rounded border px-3 py-2", data: { role: "blank-toggle" } %>
    <%= button_to "A-", operator_font_path(@session, dir: "down"), method: :patch,
          form: { data: { turbo: false } }, class: "rounded border px-3 py-2" %>
    <%= button_to "A+", operator_font_path(@session, dir: "up"), method: :patch,
          form: { data: { turbo: false } }, class: "rounded border px-3 py-2" %>
    <span class="text-sm text-slate-500 self-center" data-role="font-scale"><%= @session.font_scale %>%</span>
    <% if @session.active? %>
      <%= button_to "End service", operator_end_path(@session), method: :delete,
            form: { data: { turbo: false } }, class: "rounded bg-red-700 text-white px-3 py-2 ml-auto",
            data: { role: "end-service" } %>
    <% end %>
  </div>

  <p class="text-xs text-slate-400 mb-4" data-role="clicker-hint">
    Tip: a presentation clicker or your keyboard arrows (← →, Page Up/Down) advance the service. Press <kbd class="px-1 rounded bg-slate-200 text-slate-700">B</kbd> to blank.
  </p>

  <%# A true preview of what's on the projection screen: the SAME projector frame (plain lyrics,
      no chords), on a dark mini-stage so it reads like the projector. %>
  <div class="rounded mb-6 overflow-hidden projector-preview" data-role="operator-frame">
    <%= render "live/projector_frame", session: @session %>
  </div>

  <h2 class="text-sm font-semibold mb-2">Jump to item</h2>
  <ol class="divide-y border rounded">
    <% @session.service_set.ordered_items.each do |item| %>
      <li class="py-2 px-3 flex items-center justify-between">
        <span><%= item.item.title %></span>
        <%= button_to "Go", operator_goto_path(@session, set_item_id: item.id), method: :patch,
              class: "underline text-sm", form: { data: { turbo: false } } %>
      </li>
    <% end %>
  </ol>

  <div class="mt-6 grid gap-4 sm:grid-cols-2" data-role="join-links">
    <% projector_url = projector_url(@session.projector_token, host: request.host_with_port, protocol: request.protocol.delete_suffix("://")) %>
    <% musician_url  = musician_url(@session.musician_token,  host: request.host_with_port, protocol: request.protocol.delete_suffix("://")) %>

    <div class="rounded-lg ring-1 ring-slate-200 bg-white p-4 flex items-center gap-4" data-role="projector-join">
      <%= qr_svg(projector_url, size: 128) %>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Projector</div>
        <%= link_to projector_url, projector_url, target: "_blank", rel: "noopener",
              class: "text-sm text-indigo-700 underline break-all", data: { role: "projector-url" } %>
        <p class="text-xs text-slate-400 mt-1">Open on the projection screen, or scan to join.</p>
      </div>
    </div>

    <div class="rounded-lg ring-1 ring-slate-200 bg-white p-4 flex items-center gap-4" data-role="musician-join">
      <%= qr_svg(musician_url, size: 128) %>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Musician</div>
        <%= link_to musician_url, musician_url, target: "_blank", rel: "noopener",
              class: "text-sm text-indigo-700 underline break-all", data: { role: "musician-url" } %>
        <p class="text-xs text-slate-400 mt-1">Musicians scan this to follow along on their phone.</p>
      </div>
    </div>
  </div>
</div>
