<div class="my-6 w-full px-4 sm:px-6" data-role="operator" data-controller="operator-clicker">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-3 min-w-0">
      <h1 class="text-2xl font-bold truncate"><%= @session.service_set.name %></h1>
      <span class="badge <%= @session.active? ? 'badge-success' : 'badge-ghost' %>"
            data-role="live-indicator"><%= @session.active? ? t("live.operator.live") : t("live.operator.ended") %></span>
    </div>
    <%# Keynote-style wall clock so whoever runs the service can keep time. %>
    <span class="text-3xl font-light tabular-nums text-info" data-controller="clock" data-role="clock"
          aria-label="<%= t('live.operator.clock') %>"></span>
    <div class="flex items-center gap-2">
      <%= link_to t("live.operator.back_to_service"), service_set_path(@session.service_set),
            class: "btn btn-ghost btn-sm", data: { role: "back-to-set" } %>
      <% if @session.active? %>
        <%= button_to t("live.operator.end_service"), operator_end_path(@session), method: :delete,
              form: { data: { turbo: false } }, class: "btn btn-error btn-outline btn-sm",
              data: { role: "end-service" } %>
      <% end %>
    </div>
  </div>

  <%# Presenter view (like Keynote): Now on the left, the REAL rendered next slide on the right,
      controls in the Now card's footer. On a phone the cards stack Now (with controls) → Next, so
      the main slide keeps the full width and the buttons sit under the thumb. Both previews use the same projector frame
      and fit controller as the projection screen, so they look exactly like it. %>
  <%# Each preview is a card: a header row (what it is + where it is in the service), the slide,
      and for Now a footer with the controls, so the buttons visibly belong to the live slide. %>
  <div class="grid gap-4 mb-6 lg:grid-cols-[3fr_2fr] lg:items-start">
    <section class="card card-border bg-base-100 shadow-sm min-w-0" data-role="now-panel"
             data-controller="auto-page-label" data-action="auto-pages:change->auto-page-label#update auto-pages:progress->auto-page-label#progress"
             data-auto-page-label-template-value="<%= t("live.operator.page", n: "%{n}", count: "%{count}") %>">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 px-4 py-2.5 border-b border-base-200 text-sm">
        <span class="badge badge-error badge-sm font-bold uppercase"><%= t("live.operator.now") %></span>
        <span class="font-semibold min-w-0" data-role="now-label"><%= operator_stop_label(@session) %></span>
        <%= operator_auto_badge(@session) %>
        <% if @session.blanked %><span class="badge badge-warning badge-sm" data-role="blanked-badge"><%= t("live.operator.blanked") %></span><% end %>
        <% if @stop_index %><span class="ml-auto text-base-content/60 tabular-nums" data-role="now-position"><%= t("live.operator.position", n: @stop_index + 1, count: @stop_count) %></span><% end %>
      </div>
      <div class="p-3">
        <div class="rounded overflow-hidden projector-preview" data-role="operator-frame">
          <%= render "live/projector_frame", session: @session %>
          <% if @session.blanked %>
            <%# The preview stage is always black, so fixed light text (not base-content) stays legible. %>
            <span class="absolute inset-0 z-10 flex items-center justify-center text-sm text-white/40"><%= t("live.operator.screen_blank") %></span>
          <% end %>
        </div>
        <% if operator_auto_slide?(@session) && !@session.blanked %>
          <%# Time left on the current page, fed by the preview's auto-pages clock. %>
          <progress class="progress progress-info w-full h-1 mt-2 block" value="0" max="100"
                    data-auto-page-label-target="progress" data-role="auto-progress"
                    aria-label="<%= t('live.operator.auto_badge_title') %>"></progress>
        <% end %>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 border-t border-base-200" data-role="operator-controls">
        <div class="join">
          <%= button_to t("live.operator.back"), operator_back_path(@session), method: :patch,
                form: { data: { turbo: false, "operator-clicker-target": "back" } }, class: "btn join-item" %>
          <%= button_to t("live.operator.next"), operator_advance_path(@session), method: :patch,
                form: { data: { turbo: false, "operator-clicker-target": "next" } }, class: "btn btn-primary join-item px-10" %>
          <%= button_to (@session.blanked ? t("live.operator.unblank") : t("live.operator.blank")), operator_blank_path(@session), method: :patch,
                form: { data: { turbo: false, "operator-clicker-target": "blank" } }, class: "btn join-item", data: { role: "blank-toggle" } %>
        </div>
        <p class="text-xs text-base-content/50" data-role="clicker-hint">
          <%= t("live.operator.clicker_hint_html", blank_key: tag.kbd("B", class: "kbd kbd-xs")) %>
        </p>
      </div>
    </section>

    <section class="card card-border bg-base-100 shadow-sm min-w-0" data-role="next-panel"
             data-controller="auto-page-label" data-action="auto-pages:change->auto-page-label#update auto-pages:progress->auto-page-label#progress"
             data-auto-page-label-template-value="<%= t("live.operator.page", n: "%{n}", count: "%{count}") %>">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 px-4 py-2.5 border-b border-base-200 text-sm">
        <span class="badge badge-primary badge-outline badge-sm font-bold uppercase"><%= t("live.operator.next_up") %></span>
        <% if @next_session %>
          <span class="font-semibold min-w-0" data-role="next-label"><%= operator_stop_label(@next_session) %></span>
          <%= operator_auto_badge(@next_session) %>
          <span class="ml-auto text-base-content/60 tabular-nums" data-role="next-position"><%= t("live.operator.position", n: @stop_index.to_i + 2, count: @stop_count) %></span>
        <% end %>
      </div>
      <div class="p-3">
        <div class="rounded overflow-hidden projector-preview" data-role="next-frame">
          <% if @next_session %>
            <%= render "live/projector_frame", session: @next_session, preview: true %>
          <% else %>
            <span class="absolute inset-0 flex items-center justify-center text-sm text-white/50" data-role="end-of-service"><%= t("live.operator.end_of_service") %></span>
          <% end %>
        </div>
      </div>
    </section>
  </div>

  <h2 class="text-sm font-semibold mb-2"><%= t("live.operator.jump_to_item") %></h2>
  <ul class="list bg-base-100 rounded-box border border-base-200">
    <% @session.service_set.ordered_items.each do |item| %>
      <li class="list-row items-center">
        <span class="list-col-grow flex flex-wrap items-center gap-2" data-role="jump-item">
          <span><%= item.item.title %></span>
          <%= set_item_auto_badge(item) %>
        </span>
        <%= button_to t("live.operator.go"), operator_goto_path(@session, set_item_id: item.id), method: :patch,
              class: "btn btn-ghost btn-sm", form: { data: { turbo: false } } %>
      </li>
    <% end %>
  </ul>

  <div class="mt-6 grid gap-4 sm:grid-cols-2" data-role="join-links">
    <% projector_url = projector_url(@session.projector_token, host: request.host_with_port, protocol: request.protocol.delete_suffix("://")) %>
    <% musician_url  = musician_url(@session.musician_token,  host: request.host_with_port, protocol: request.protocol.delete_suffix("://")) %>

    <div class="card card-border bg-base-100 flex-row items-center gap-4 p-4" data-role="projector-join">
      <%= qr_svg(projector_url, size: 128) %>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wide text-base-content/60 mb-1"><%= t("live.operator.projector") %></div>
        <%= link_to projector_url, projector_url, target: "_blank", rel: "noopener",
              class: "link link-primary text-sm break-all", data: { role: "projector-url" } %>
        <p class="text-xs text-base-content/50 mt-1"><%= t("live.operator.projector_hint") %></p>
      </div>
    </div>

    <div class="card card-border bg-base-100 flex-row items-center gap-4 p-4" data-role="musician-join">
      <%= qr_svg(musician_url, size: 128) %>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wide text-base-content/60 mb-1"><%= t("live.operator.musician") %></div>
        <%= link_to musician_url, musician_url, target: "_blank", rel: "noopener",
              class: "link link-primary text-sm break-all", data: { role: "musician-url" } %>
        <p class="text-xs text-base-content/50 mt-1"><%= t("live.operator.musician_hint") %></p>
      </div>
    </div>
  </div>
</div>
