<div class="mx-auto my-8 max-w-4xl px-4 sm:px-6" data-role="operator" data-controller="operator-clicker">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold"><%= @session.service_set.name %></h1>
    <span class="badge <%= @session.active? ? 'badge-success' : 'badge-ghost' %>"
          data-role="live-indicator"><%= @session.active? ? "LIVE" : "ENDED" %></span>
  </div>

  <div class="flex gap-2 mb-4" data-role="operator-controls">
    <%= button_to "← Back", operator_back_path(@session), method: :patch,
          form: { data: { turbo: false, "operator-clicker-target": "back" } }, class: "btn" %>
    <%= button_to "Next →", operator_advance_path(@session), method: :patch,
          form: { data: { turbo: false, "operator-clicker-target": "next" } }, class: "btn btn-primary" %>
    <%= button_to (@session.blanked ? "Unblank" : "Blank"), operator_blank_path(@session), method: :patch,
          form: { data: { turbo: false, "operator-clicker-target": "blank" } }, class: "btn", data: { role: "blank-toggle" } %>
    <% if @session.active? %>
      <%= button_to "End service", operator_end_path(@session), method: :delete,
            form: { data: { turbo: false }, class: "ml-auto" }, class: "btn btn-error",
            data: { role: "end-service" } %>
    <% end %>
  </div>

  <p class="text-xs text-base-content/50 mb-4" data-role="clicker-hint">
    Tip: a presentation clicker or your keyboard arrows (← →, Page Up/Down) advance the service. Press <kbd class="kbd kbd-xs">B</kbd> to blank.
  </p>

  <%# A true preview of what's on the projection screen: the SAME projector frame (plain lyrics,
      no chords), on a dark mini-stage so it reads like the projector. %>
  <div class="rounded mb-6 overflow-hidden projector-preview" data-role="operator-frame">
    <%= render "live/projector_frame", session: @session %>
  </div>

  <h2 class="text-sm font-semibold mb-2">Jump to item</h2>
  <ul class="list bg-base-100 rounded-box border border-base-200">
    <% @session.service_set.ordered_items.each do |item| %>
      <li class="list-row items-center">
        <span class="list-col-grow"><%= item.item.title %></span>
        <%= button_to "Go", operator_goto_path(@session, set_item_id: item.id), method: :patch,
              class: "btn btn-ghost btn-sm", form: { data: { turbo: false } } %>
      </li>
    <% end %>
  </ul>

  <div class="mt-6 grid gap-4 sm:grid-cols-2" data-role="join-links">
    <% projector_url = projector_url(@session.projector_token, host: request.host_with_port, protocol: request.protocol.delete_suffix("://")) %>
    <% musician_url  = musician_url(@session.musician_token,  host: request.host_with_port, protocol: request.protocol.delete_suffix("://")) %>

    <div class="card card-border bg-base-100 flex-row items-center gap-4 p-4" data-role="projector-join">
      <%= qr_svg(projector_url, size: 128) %>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wide text-base-content/60 mb-1">Projector</div>
        <%= link_to projector_url, projector_url, target: "_blank", rel: "noopener",
              class: "link link-primary text-sm break-all", data: { role: "projector-url" } %>
        <p class="text-xs text-base-content/50 mt-1">Open on the projection screen, or scan to join.</p>
      </div>
    </div>

    <div class="card card-border bg-base-100 flex-row items-center gap-4 p-4" data-role="musician-join">
      <%= qr_svg(musician_url, size: 128) %>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wide text-base-content/60 mb-1">Musician</div>
        <%= link_to musician_url, musician_url, target: "_blank", rel: "noopener",
              class: "link link-primary text-sm break-all", data: { role: "musician-url" } %>
        <p class="text-xs text-base-content/50 mt-1">Musicians scan this to follow along on their phone.</p>
      </div>
    </div>
  </div>
</div>
