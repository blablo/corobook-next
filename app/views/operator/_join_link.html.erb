<%#
  One device's join code (scan it or click to copy, see _join_code), with an Enlarge link that
  shows it large in a dialog over the blurred page, so a phone can't pick up one of the others.
  Locals: url, title, role (data-role prefix).
%>
<div class="flex flex-col items-start" data-role="<%= role %>-join">
  <%= render "join_code", url: url, title: title, role: "#{role}-copy" %>
  <button type="button" class="link link-primary link-hover text-xs ml-2"
          aria-label="<%= t("live.operator.enlarge_join", name: title) %>" data-role="<%= role %>-enlarge"
          onclick="document.getElementById('<%= role %>-code-modal').showModal()"><%= t("live.operator.enlarge") %></button>
  <dialog id="<%= role %>-code-modal" class="modal backdrop-blur-sm" data-role="<%= role %>-code-modal">
    <%# The blur behind the box keeps a phone from reading the small codes on the page; a
        dimmed but sharp code can still scan. Esc, ✕ or a click outside closes it. %>
    <div class="modal-box max-w-md">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-semibold"><%= title %></h3>
          <p class="text-sm text-base-content/60"><%= t("live.operator.enlarge_help") %></p>
        </div>
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost" aria-label="<%= t("live.operator.close") %>">✕</button>
        </form>
      </div>
      <div class="mt-4 flex justify-center">
        <%= render "join_code", url: url, title: title, role: "#{role}-copy-large", large: true %>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button><%= t("live.operator.close") %></button></form>
  </dialog>
</div>
