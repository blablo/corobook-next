<%#
  A follow link as a QR code and a Copy link button (projector, band view, speaker view); the
  button's title shows the address on hover. Locals: url, title, role (data-role prefix).
%>
<div class="flex flex-row items-center gap-5" data-role="<%= role %>-join">
  <div class="shrink-0 rounded-box border border-base-300 bg-white p-2"><%= qr_svg(url, size: 112) %></div>
  <div class="min-w-0 space-y-1">
    <h2 class="card-title text-base"><%= title %></h2>
    <div data-controller="clipboard" data-clipboard-text-value="<%= url %>" data-clipboard-done-value="<%= t('live.operator.copied') %>">
      <button type="button" class="btn btn-sm btn-soft btn-primary mt-1" title="<%= url %>"
              data-action="clipboard#copy" data-clipboard-target="label" data-role="<%= role %>-copy"
              data-url="<%= url %>"><%= t("live.operator.copy_link") %></button>
    </div>
  </div>
</div>
