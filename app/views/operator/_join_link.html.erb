<%#
  One device's join code (scan it or click to copy, see _join_code), with an Enlarge link that
  shows it alone and large over the whole page, so a phone can't pick up one of the others.
  Locals: url, title, role (data-role prefix).
%>
<div class="flex flex-col items-start" data-role="<%= role %>-join">
  <%= render "join_code", url: url, title: title, role: "#{role}-copy" %>
  <button type="button" class="link link-primary link-hover text-xs ml-2"
          aria-label="<%= t("live.operator.enlarge_join", name: title) %>" data-role="<%= role %>-enlarge"
          onclick="document.getElementById('<%= role %>-code-modal').showModal()"><%= t("live.operator.enlarge") %></button>
  <dialog id="<%= role %>-code-modal" class="modal" data-role="<%= role %>-code-modal">
    <%# The box fills the page instead of sitting on DaisyUI's dimmed backdrop: a camera can still
        read a dimmed code. Esc closes it too. %>
    <div class="modal-box size-full max-w-none max-h-none rounded-none shadow-none flex flex-col items-center justify-center gap-3">
      <%= render "join_code", url: url, title: title, role: "#{role}-copy-large", large: true %>
      <p class="text-sm text-base-content/60 text-center"><%= t("live.operator.enlarge_help") %></p>
      <form method="dialog"><button class="btn btn-ghost"><%= t("live.operator.close") %></button></form>
    </div>
  </dialog>
</div>
