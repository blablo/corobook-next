<%#
  One device's join tile: its name, the QR code (scan it, or click to open the page), and Copy
  link and Enlarge beside it. Enlarge shows the code large in a dialog over the blurred
  page, so a phone can't pick up one of the others.
  Locals: url, title, role (data-role prefix), icon (OperatorHelper::ICON_PATHS key).
%>
<div class="rounded-box bg-base-200 p-4 flex flex-col gap-2" data-role="<%= role %>-join">
  <div class="flex items-center justify-center gap-2">
    <span class="inline-grid place-items-center size-7 rounded-box bg-base-100 text-primary"><%= operator_icon(icon) %></span>
    <span class="font-semibold"><%= title %></span>
  </div>
  <%# Copy link and Enlarge stacked just right of the code, which stays centred under the name.
      A tile is too narrow for that below xl, so there they sit side by side under the code. %>
  <div class="relative mx-auto w-fit">
    <%= render "join_code", url: url, title: title, role: "#{role}-open" %>
    <div class="mt-1.5 flex justify-center gap-1 xl:mt-0 xl:absolute xl:left-full xl:top-1/2 xl:-translate-y-1/2 xl:ml-2 xl:flex-col">
      <%= render "copy_link_button", url: url, title: title, role: "#{role}-copy", tip: "xl:tooltip-right" %>
      <div class="tooltip xl:tooltip-right" data-tip="<%= t("live.operator.enlarge") %>">
        <button type="button" class="btn btn-ghost btn-sm btn-square text-base-content/70 hover:text-base-content"
                aria-label="<%= t("live.operator.enlarge_join", name: title) %>" data-role="<%= role %>-enlarge"
                onclick="document.getElementById('<%= role %>-code-modal').showModal()"><%= operator_icon(:arrows_out) %></button>
      </div>
    </div>
  </div>

  <dialog id="<%= role %>-code-modal" class="modal backdrop-blur-sm" data-role="<%= role %>-code-modal">
    <%# The blur behind the box keeps a phone from reading the small codes on the page; a
        dimmed but sharp code can still scan. Esc, ✕ or a click outside closes it. %>
    <div class="modal-box max-w-md">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-semibold"><%= title %></h3>
          <p class="text-sm text-base-content/60"><%= t("live.operator.enlarge_help") %></p>
        </div>
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost" aria-label="<%= t("live.operator.close") %>">✕</button>
        </form>
      </div>
      <div class="mt-4 flex flex-col items-center gap-2">
        <%= render "join_code", url: url, title: title, role: "#{role}-open-large", large: true %>
        <%= render "copy_link_button", url: url, title: title, role: "#{role}-copy-large" %>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button><%= t("live.operator.close") %></button></form>
  </dialog>
</div>
