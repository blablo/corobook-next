<% content_for :title, t("settings.general.title") %>

<div class="mx-auto max-w-3xl p-4" data-role="settings">
  <h1 class="text-2xl font-semibold mb-6"><%= t("settings.general.title") %></h1>

  <%# ── Church subdomain ─────────────────────────────────────────── %>
  <section data-role="subdomain-settings">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-2"><%= t("settings.general.subdomain_heading") %></h2>
    <p class="text-sm text-base-content/60 mb-4 max-w-prose">
      <%= t("settings.general.subdomain_intro_html", church: tag.span(@church.name, class: "font-medium")) %>
      <span class="text-base-content/50"><%= t("settings.general.subdomain_coming_soon") %></span>
    </p>

    <%= form_with model: @church, url: settings_path, method: :patch, data: { controller: "subdomain-preview" } do |f| %>
      <%= hidden_field_tag :section, "general" %>
      <% if @church.errors[:subdomain].any? %>
        <div class="alert alert-error mb-4 text-sm" data-role="subdomain-error">
          <div><%= t("settings.general.subdomain_error", message: @church.errors[:subdomain].to_sentence) %></div>
        </div>
      <% end %>

      <fieldset class="fieldset max-w-md">
        <%= f.label :subdomain, t("settings.general.subdomain_label"), class: "fieldset-legend" %>
        <label class="input input-bordered flex items-center gap-1 w-full">
          <%= f.text_field :subdomain,
                value: @church.subdomain,
                placeholder: "gracia",
                autocomplete: "off", autocapitalize: "off", spellcheck: "false",
                class: "grow", data: { role: "subdomain-input", action: "input->subdomain-preview#update" } %>
          <span class="text-base-content/50 text-sm whitespace-nowrap">.<%= request.domain.presence || "example.com" %></span>
        </label>
        <p class="label text-base-content/60">
          <%= t("settings.general.subdomain_help") %>
        </p>
      </fieldset>

      <p class="text-sm mt-3 flex items-center gap-2 flex-wrap">
        <span><%= t("settings.general.address_will_be") %></span>
        <code class="px-1 py-0.5 rounded bg-base-200" data-role="subdomain-preview-url" data-subdomain-preview-target="url">
          <%= @church.subdomain.present? ? "https://#{@church.subdomain}.#{request.domain.presence || 'example.com'}/" : t("settings.general.not_set") %>
        </code>
        <button type="button" class="btn btn-ghost btn-xs gap-1 <%= 'btn-disabled' if @church.subdomain.blank? %>"
                data-role="copy-link" data-subdomain-preview-target="copyBtn"
                data-action="subdomain-preview#copy" aria-label="<%= t("settings.general.copy_link") %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m11.25 5.5H16.5a1.125 1.125 0 0 1-1.125-1.125v-3.5"/></svg>
          <span data-subdomain-preview-target="copyLabel"><%= t("settings.general.copy") %></span>
        </button>
      </p>

      <div class="mt-4">
        <%= f.submit t("settings.general.save"), class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </section>
</div>
