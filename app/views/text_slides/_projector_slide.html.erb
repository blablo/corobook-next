<%#
  Projector rendering of a text slide (Req 3.5). Locals: slide, page (0-based, optional).
  When the slide has a background image it fills the stage as a cover photo, with a dark scrim
  behind the text for legibility. Otherwise the slide renders on the church's normal background.
%>
<% if slide.background_image? %>
  <div class="projector-slide-bg" data-role="slide-bg"
       style="background-image: url('<%= rails_blob_path(slide.background_image, only_path: true) %>');">
    <div class="projector-slide-scrim"></div>
  </div>
<% end %>
<div class="projector-slide <%= slide.alignment_classes %><%= ' has-bg' if slide.background_image? %>" data-controller="fit" data-role="projector-slide"
     data-fit-fixed-value="<%= slide.font_size.to_i %>">
  <div data-fit-target="content" class="projector-slide-body">
    <%= raw slide.rendered_html(local_assigns.fetch(:page, 0)) %>
  </div>
</div>
