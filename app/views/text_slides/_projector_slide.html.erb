<%#
  Projector rendering of a text slide (Req 3.5). Locals: slide, page (0-based, optional).
  Neutral style — slides no longer carry a subtype. Renders one page of the slide.
%>
<div class="projector-slide" data-controller="fit" data-role="projector-slide">
  <div data-fit-target="content" class="projector-slide-body">
    <%= raw slide.rendered_html(local_assigns.fetch(:page, 0)) %>
  </div>
</div>
