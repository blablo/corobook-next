<div class="mx-auto my-8 max-w-3xl px-4 sm:px-6">
  <div class="flex items-center justify-between mb-2">
    <h1 class="text-2xl font-bold flex items-center gap-2">
      <%= @text_slide.title %>
      <% if @text_slide.archived? %>
        <span class="badge badge-warning badge-sm" data-role="archived-badge"><%= t("slides.archive.badge") %></span>
      <% end %>
    </h1>
    <% if can_edit? %>
      <div class="flex items-center gap-1">
        <%= link_to t("slides.show.edit"), edit_text_slide_path(@text_slide), class: "btn btn-ghost btn-sm" %>
        <% if @text_slide.reusable? %>
          <% if @text_slide.archived? %>
            <%= button_to t("slides.archive.restore"), unarchive_text_slide_path(@text_slide), method: :patch,
                  class: "btn btn-ghost btn-sm", data: { role: "unarchive-slide" } %>
          <% else %>
            <%= button_to t("slides.archive.archive"), archive_text_slide_path(@text_slide), method: :patch,
                  class: "btn btn-ghost btn-sm", data: { role: "archive-slide" } %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if @text_slide.archived? %>
    <p class="text-sm text-base-content/60 mb-3" data-role="archived-note">
      <%= t("slides.archive.note", date: @text_slide.archived_at.strftime(t("slides.archive.date_format"))) %>
    </p>
  <% end %>

  <% if @text_slide.tags.present? %>
    <div class="flex flex-wrap gap-1.5 mb-4">
      <% @text_slide.tags.each do |tag| %>
        <%= link_to tag, text_slides_path(tag: tag), class: "badge badge-ghost" %>
      <% end %>
    </div>
  <% end %>

  <section class="mt-4" data-role="projector-preview">
    <h2 class="text-sm text-base-content/50 mb-2">
      <%= @text_slide.page_count > 1 ? t("slides.show.projector_preview_pages", count: @text_slide.page_count) : t("slides.show.projector_preview") %>
    </h2>
    <div class="flex flex-col gap-3">
      <% @text_slide.page_count.times do |i| %>
        <%# Bounded 16:9 mini-stage (position:relative) so an absolute background image is
            contained within the preview box rather than escaping to fill the page. %>
        <div class="projector-preview rounded overflow-hidden" style="<%= @text_slide.projector_style %>">
          <%= render "projector_slide", slide: @text_slide, page: i %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="mt-6" data-role="musician-preview">
    <h2 class="text-sm text-base-content/50 mb-2"><%= t("slides.show.musician_view") %></h2>
    <div class="flex flex-col gap-3">
      <% @text_slide.page_count.times do |i| %>
        <%= render "musician_slide", slide: @text_slide, page: i %>
      <% end %>
    </div>
  </section>
</div>
