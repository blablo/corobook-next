<% slide = @text_slide %>
<div class="space-y-6" data-role="slide-show">
  <%# ── Header ──────────────────────────────────────────────────── %>
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-2xl sm:text-3xl font-semibold leading-tight truncate"><%= slide.title %></h1>
        <% if slide.archived? %>
          <span class="badge badge-soft badge-warning" data-role="archived-badge"><%= t("slides.archive.badge") %></span>
        <% end %>
      </div>
      <% if slide.tags.present? %>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <% slide.tags.each do |tag| %>
            <%= link_to tag, text_slides_path(tag: tag), class: "badge badge-ghost" %>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if can_edit? %>
      <div class="flex items-center gap-2">
        <% if slide.reusable? %>
          <% if slide.archived? %>
            <%= button_to t("slides.archive.restore"), unarchive_text_slide_path(slide), method: :patch,
                  class: "btn btn-ghost", data: { role: "unarchive-slide" } %>
          <% else %>
            <%= button_to t("slides.archive.archive"), archive_text_slide_path(slide), method: :patch,
                  class: "btn btn-ghost", data: { role: "archive-slide" } %>
          <% end %>
        <% end %>
        <%= link_to edit_text_slide_path(slide), class: "btn btn-primary" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/></svg>
          <%= t("slides.show.edit") %>
        <% end %>
      </div>
    <% end %>
  </header>

  <% if slide.archived? %>
    <div role="status" class="alert alert-warning alert-soft" data-role="archived-note">
      <span><%= t("slides.archive.note", date: slide.archived_at.strftime(t("slides.archive.date_format"))) %></span>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_18rem] gap-6 items-start">
    <div class="space-y-6 min-w-0">
      <%# ── Projector: every page, exactly as it projects ─────────── %>
      <section class="card card-border bg-base-100" data-role="projector-preview">
        <div class="card-body">
          <h2 class="card-title text-base">
            <%= slide.page_count > 1 ? t("slides.show.projector_preview_pages", count: slide.page_count) : t("slides.show.projector_preview") %>
          </h2>
          <%# grid-cols-1 (not an implicit auto column): the preview is a size container with no
              intrinsic width, so an auto column would shrink it to nothing. %>
          <div class="grid grid-cols-1 gap-4 <%= "md:grid-cols-2" if slide.page_count > 1 %>">
            <% slide.page_count.times do |i| %>
              <figure class="relative">
                <%# Bounded 16:9 mini-stage (position:relative) so an absolute background image is
                    contained within the preview box rather than escaping to fill the page. %>
                <div class="projector-preview rounded-box overflow-hidden" style="<%= slide.projector_style %>">
                  <%= render "projector_slide", slide: slide, page: i %>
                </div>
                <% if slide.page_count > 1 %>
                  <figcaption class="badge badge-neutral badge-sm absolute top-2 left-2 z-10"><%= i + 1 %></figcaption>
                <% end %>
              </figure>
            <% end %>
          </div>
        </div>
      </section>

      <%# ── What the band sees ───────────────────────────────────── %>
      <section class="card card-border bg-base-100" data-role="musician-preview">
        <div class="card-body">
          <h2 class="card-title text-base"><%= t("slides.show.musician_view") %></h2>
          <div class="flex flex-col gap-3">
            <% slide.page_count.times do |i| %>
              <div class="rounded-box border border-base-300 p-4"><%= render "musician_slide", slide: slide, page: i %></div>
            <% end %>
          </div>
        </div>
      </section>
    </div>

    <%# ── Details ─────────────────────────────────────────────────── %>
    <aside class="card card-border bg-base-100 lg:sticky lg:top-20" data-role="slide-details">
      <div class="card-body gap-4">
        <h2 class="card-title text-base"><%= t("slides.show.details") %></h2>
        <dl class="space-y-3">
          <div>
            <dt class="text-xs text-base-content/60"><%= t("slides.show.pages_label") %></dt>
            <dd><%= slide.page_count %><% if slide.imported? %> · <%= t("slides.show.imported_pdf") %><% end %></dd>
          </div>
          <% if slide.page_count > 1 %>
            <div>
              <dt class="text-xs text-base-content/60"><%= t("slides.form.auto_advance.legend") %></dt>
              <dd data-role="auto-advance-detail">
                <% if slide.auto_advance? %>
                  <%= t("slides.show.auto_every", s: slide.auto_advance_seconds) %>
                  · <%= t("slides.form.auto_advance.transitions.#{slide.auto_advance_transition}") %>
                  · <%= slide.auto_advance_loop ? t("slides.show.auto_loops") : t("slides.show.auto_stops") %>
                <% else %>
                  <%= t("slides.show.auto_off") %>
                <% end %>
              </dd>
            </div>
          <% end %>
          <% unless slide.imported? %>
            <div>
              <dt class="text-xs text-base-content/60"><%= t("slides.show.background_label") %></dt>
              <dd class="flex items-center gap-2">
                <% unless slide.bg_type == "image" %>
                  <span class="inline-block size-4 rounded-field border border-base-300" style="background: <%= Corobook::ProjectorSettings.background_css(slide.bg_type, slide.bg_color, slide.bg_color2, slide.bg_gradient_angle) %>"></span>
                <% end %>
                <%= t("slides.form.bg_type.#{slide.bg_type}") %>
              </dd>
            </div>
            <div>
              <dt class="text-xs text-base-content/60"><%= t("slides.show.text_label") %></dt>
              <dd class="flex items-center gap-2">
                <span class="inline-block size-4 rounded-field border border-base-300" style="background: <%= slide.text_color %>"></span>
                <%= t("settings.projection.font_#{slide.font}") %>,
                <%= slide.font_size ? t("slides.form.font_size_percent", percent: slide.font_size) : t("slides.form.font_size_auto_short") %>
              </dd>
            </div>
            <div>
              <dt class="text-xs text-base-content/60"><%= t("slides.show.position_label") %></dt>
              <dd><%= t("slides.form.text_align.#{slide.text_align}") %>, <%= t("slides.form.vertical_align.#{slide.vertical_align}") %></dd>
            </div>
          <% end %>
          <div>
            <dt class="text-xs text-base-content/60"><%= t("songs.show.last_used") %></dt>
            <dd data-role="last-used">
              <% if @last_service %>
                <%= link_to @last_service.name, service_set_path(@last_service), class: "link link-hover" %>
              <% else %>
                <%= t("songs.index.never_used") %>
              <% end %>
            </dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</div>
