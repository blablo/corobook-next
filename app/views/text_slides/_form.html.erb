<%= form_with model: text_slide, html: { multipart: true },
      data: { controller: "slide-editor", "slide-editor-url-value": preview_text_slides_path } do |f| %>
  <% if text_slide.errors.any? %>
    <div role="alert" class="alert alert-error mb-4" data-role="slide-errors">
      <span><%= text_slide.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="card card-border bg-base-100">
    <div class="card-body">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 items-start">
        <%# ── Editor column ───────────────────────────────────────────── %>
        <div class="flex flex-col gap-4 min-w-0">
          <%# Title %>
          <fieldset class="fieldset">
            <%= f.label :title, t("slides.form.title_label"), class: "fieldset-legend" %>
            <%= f.text_field :title, class: "input w-full", placeholder: t("slides.form.title_placeholder") %>
          </fieldset>

          <%# Background image (projection only) %>
          <fieldset class="fieldset">
            <%= f.label :background_image, t("slides.form.background_label"), class: "fieldset-legend" %>
            <% if text_slide.background_image? %>
              <div class="flex items-center gap-3" data-role="slide-bg-current">
                <%= image_tag rails_blob_path(text_slide.background_image, only_path: true),
                      class: "h-14 w-24 object-cover rounded border border-base-300", alt: t("slides.form.current_background_alt") %>
                <label class="label">
                  <%= f.check_box :remove_background_image, { class: "checkbox checkbox-sm" }, "1", "0" %>
                  <%= t("slides.form.remove") %>
                </label>
              </div>
            <% end %>
            <%= f.file_field :background_image, accept: "image/png,image/jpeg,image/webp,image/gif",
                  class: "file-input w-full" %>
            <p class="label whitespace-normal"><%= t("slides.form.background_help_html") %></p>
          </fieldset>

          <%# Font size (all pages). Auto scales the text to fit the screen. %>
          <fieldset class="fieldset">
            <%= f.label :font_size, t("slides.form.font_size_label"), class: "fieldset-legend" %>
            <%= f.select :font_size,
                  [ [ t("slides.form.font_size_auto"), "" ] ] + TextSlide::FONT_SIZE_OPTIONS.map { |n| [ t("slides.form.font_size_percent", percent: n), n ] },
                  {}, class: "select w-full",
                  data: { role: "slide-font-size", action: "change->slide-editor#setFontSize" } %>
            <p class="label whitespace-normal"><%= t("slides.form.font_size_help") %></p>
          </fieldset>

          <%# Tags %>
          <fieldset class="fieldset">
            <legend class="fieldset-legend"><%= t("slides.form.tags_label") %></legend>
            <%# Chip input: custom by design (DaisyUI has no tag-input primitive), styled like an input. %>
            <div class="flex flex-wrap items-center gap-1.5 w-full rounded-field border border-base-300 bg-base-100 px-2 py-1.5 min-h-10 focus-within:border-primary cursor-text"
                 data-action="click->slide-editor#focusTag">
              <span class="contents" data-slide-editor-target="tagChips"></span>
              <input type="text" list="church-tags" placeholder="<%= t('slides.form.tag_placeholder') %>"
                     class="flex-1 min-w-32 bg-transparent border-0 focus:outline-none text-sm py-0.5"
                     data-slide-editor-target="tagInput" data-action="keydown->slide-editor#onTagKey">
            </div>
            <datalist id="church-tags">
              <% (local_assigns[:church_tags] || []).each do |t| %><option value="<%= t %>"><% end %>
            </datalist>
            <p class="label whitespace-normal"><%= t("slides.form.tags_help") %></p>
            <div data-slide-editor-target="tagFields"></div>
          </fieldset>

          <%# Pages %>
          <fieldset class="fieldset">
            <legend class="fieldset-legend"><%= t("slides.form.pages_label") %></legend>

            <%# Page thumbnail strip: click to switch, drag to reorder, ✕ to remove, + to add %>
            <div class="flex gap-2 overflow-x-auto pb-1" data-slide-editor-target="pageStrip"></div>

            <%# Editor bar + body — a joined control. The bar stays visible in both modes: the
                formatting group (toolbar target) hides in Advanced mode, the toggle stays at right. %>
            <div class="join join-vertical w-full">
              <div class="join-item flex items-center gap-1 border border-base-300 bg-base-200 p-1">
                <div class="flex flex-wrap gap-1" data-slide-editor-target="toolbar">
                  <button type="button" class="btn btn-ghost btn-xs font-bold" title="<%= t('slides.form.toolbar.bold') %>" data-action="slide-editor#bold">B</button>
                  <button type="button" class="btn btn-ghost btn-xs italic" title="<%= t('slides.form.toolbar.italic') %>" data-action="slide-editor#italic">I</button>
                  <button type="button" class="btn btn-ghost btn-xs" title="<%= t('slides.form.toolbar.heading') %>" data-action="slide-editor#heading">H</button>
                  <button type="button" class="btn btn-ghost btn-xs" title="<%= t('slides.form.toolbar.bullet') %>" data-action="slide-editor#bullet"><%= t("slides.form.toolbar.bullet_label") %></button>
                  <button type="button" class="btn btn-ghost btn-xs" title="<%= t('slides.form.toolbar.clear') %>" data-action="slide-editor#clearFormat"><%= t("slides.form.toolbar.clear_label") %></button>
                </div>
                <button type="button" class="btn btn-ghost btn-xs ml-auto" title="<%= t('slides.form.toolbar.advanced') %>"
                        data-slide-editor-target="advancedBtn" data-action="slide-editor#toggleAdvanced"><%= t("slides.form.toolbar.advanced_label") %></button>
              </div>

              <div contenteditable="true" role="textbox" aria-multiline="true" aria-label="<%= t('slides.form.body_aria') %>"
                   class="join-item border border-t-0 border-base-300 px-3 py-2 min-h-48 focus:outline-none wrap-anywhere"
                   data-slide-editor-target="rich" data-action="input->slide-editor#onRichInput keydown->slide-editor#onKeydown"></div>

              <%= f.text_area nil, name: nil,
                    class: "join-item textarea w-full font-mono text-sm hidden",
                    rows: 10, data: { "slide-editor-target": "source", action: "input->slide-editor#onSourceInput" } %>
            </div>

            <div data-slide-editor-target="pageFields"></div>
            <p class="label whitespace-normal"><%= t("slides.form.pages_help") %></p>
          </fieldset>
        </div>

        <%# ── Preview column (inside the same card) — the SAME projector mini-stage the show page
              and operator use, so what you see while editing matches what projects. ───── %>
        <div class="lg:sticky lg:top-4 min-w-0">
          <div class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-2"><%= t("slides.form.preview_label") %> <span data-slide-editor-target="previewLabel"></span></div>
          <div class="projector-preview rounded-box overflow-hidden" data-slide-editor-target="previewStage">
            <% if text_slide.background_image? %>
              <div class="projector-slide-bg" data-role="slide-bg"
                   style="background-image: url('<%= rails_blob_path(text_slide.background_image, only_path: true) %>');">
                <div class="projector-slide-scrim"></div>
              </div>
            <% end %>
            <div class="projector-slide<%= ' has-bg' if text_slide.background_image? %>" data-controller="fit" data-role="projector-slide"
                 data-fit-fixed-value="<%= text_slide.font_size.to_i %>">
              <div class="projector-slide-body" data-fit-target="content" data-slide-editor-target="preview" data-role="slide-preview"></div>
            </div>
          </div>
          <p class="text-xs text-base-content/40 mt-2"><%= t("slides.form.preview_caption") %></p>
        </div>
      </div>

      <%# Actions span the full card width, below both columns. %>
      <div class="card-actions items-center gap-3 mt-6 pt-4 border-t border-base-200">
        <%= f.submit (text_slide.persisted? ? t("slides.form.save") : t("slides.form.create")), class: "btn btn-primary",
              data: { "slide-editor-target": "submit" } %>
        <% if local_assigns[:modal] %>
          <button type="button" class="btn btn-ghost" data-action="set-builder#closeNewSlide"><%= t("slides.form.cancel") %></button>
        <% else %>
          <%= link_to t("slides.form.cancel"), (text_slide.persisted? ? text_slide_path(text_slide) : text_slides_path), class: "btn btn-ghost" %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Seed data for the controller: existing tags + pages as JSON. %>
  <script type="application/json" data-slide-editor-target="seed"><%= raw({ tags: text_slide.tags, pages: text_slide.pages.map { |p| p["body_markdown"].to_s } }.to_json) %></script>
<% end %>
