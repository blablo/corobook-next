<%= form_with model: text_slide, html: { multipart: true },
      data: { controller: "slide-editor", "slide-editor-url-value": preview_text_slides_path } do |f| %>
  <% if text_slide.errors.any? %>
    <div role="alert" class="alert alert-error mb-4" data-role="slide-errors">
      <span><%= text_slide.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="card card-border bg-base-100">
    <div class="card-body">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 items-start">
        <%# ── Editor column ───────────────────────────────────────────── %>
        <div class="flex flex-col gap-4 min-w-0">
          <%# Title %>
          <fieldset class="fieldset">
            <%= f.label :title, t("slides.form.title_label"), class: "fieldset-legend" %>
            <%= f.text_field :title, class: "input w-full", placeholder: t("slides.form.title_placeholder") %>
          </fieldset>

          <%# Tags %>
          <fieldset class="fieldset">
            <legend class="fieldset-legend"><%= t("slides.form.tags_label") %></legend>
            <%# Chip input: custom by design (DaisyUI has no tag-input primitive), styled like an input. %>
            <div class="flex flex-wrap items-center gap-1.5 w-full rounded-field border border-base-300 bg-base-100 px-2 py-1.5 min-h-10 focus-within:border-primary cursor-text"
                 data-action="click->slide-editor#focusTag">
              <span class="contents" data-slide-editor-target="tagChips"></span>
              <input type="text" list="church-tags" placeholder="<%= t('slides.form.tag_placeholder') %>"
                     class="flex-1 min-w-32 bg-transparent border-0 focus:outline-none text-sm py-0.5"
                     data-slide-editor-target="tagInput" data-action="keydown->slide-editor#onTagKey">
            </div>
            <datalist id="church-tags">
              <% (local_assigns[:church_tags] || []).each do |t| %><option value="<%= t %>"><% end %>
            </datalist>
            <p class="label whitespace-normal"><%= t("slides.form.tags_help") %></p>
            <div data-slide-editor-target="tagFields"></div>
          </fieldset>

          <%# Imported deck (PDF): pages are images, edited in the original app and re-imported.
              The text editor and appearance below stay in the DOM (the slide editor needs its
              targets and keeps submitting one page per image) but are hidden. %>
          <% if text_slide.imported? %>
            <div class="alert alert-info text-sm" data-role="imported-note"><%= t("slides.form.imported_note") %></div>
          <% end %>

          <%# Pages %>
          <fieldset class="fieldset<%= ' hidden' if text_slide.imported? %>">
            <legend class="fieldset-legend"><%= t("slides.form.pages_label") %></legend>

            <%# Page thumbnail strip: click to switch, drag to reorder, ✕ to remove, + to add %>
            <div class="flex gap-2 overflow-x-auto pb-1" data-slide-editor-target="pageStrip"></div>

            <%# Editor bar + body — a joined control. The bar stays visible in both modes: the
                formatting group (toolbar target) hides in Advanced mode, the toggle stays at right. %>
            <div class="join join-vertical w-full">
              <div class="join-item flex items-center gap-1 border border-base-300 bg-base-200 p-1">
                <div class="flex flex-wrap gap-1" data-slide-editor-target="toolbar">
                  <button type="button" class="btn btn-ghost btn-xs font-bold" title="<%= t('slides.form.toolbar.bold') %>" data-action="slide-editor#bold">B</button>
                  <button type="button" class="btn btn-ghost btn-xs italic" title="<%= t('slides.form.toolbar.italic') %>" data-action="slide-editor#italic">I</button>
                  <button type="button" class="btn btn-ghost btn-xs" title="<%= t('slides.form.toolbar.heading') %>" data-action="slide-editor#heading">H</button>
                  <button type="button" class="btn btn-ghost btn-xs" title="<%= t('slides.form.toolbar.bullet') %>" data-action="slide-editor#bullet"><%= t("slides.form.toolbar.bullet_label") %></button>
                  <button type="button" class="btn btn-ghost btn-xs" title="<%= t('slides.form.toolbar.clear') %>" data-action="slide-editor#clearFormat"><%= t("slides.form.toolbar.clear_label") %></button>
                  <button type="button" class="btn btn-ghost btn-xs" title="<%= t('slides.form.countdown.button_title') %>"
                          data-action="mousedown->slide-editor#saveSelection slide-editor#openCountdown" data-role="countdown-button"><%= t("slides.form.countdown.button") %></button>
                </div>
                <button type="button" class="btn btn-ghost btn-xs ml-auto" title="<%= t('slides.form.toolbar.advanced') %>"
                        data-slide-editor-target="advancedBtn" data-action="slide-editor#toggleAdvanced"><%= t("slides.form.toolbar.advanced_label") %></button>
              </div>

              <div contenteditable="true" role="textbox" aria-multiline="true" aria-label="<%= t('slides.form.body_aria') %>"
                   class="join-item border border-t-0 border-base-300 px-3 py-2 min-h-48 focus:outline-none wrap-anywhere"
                   data-slide-editor-target="rich" data-action="input->slide-editor#onRichInput keydown->slide-editor#onKeydown click->slide-editor#onRichClick"></div>

              <%= f.text_area nil, name: nil,
                    class: "join-item textarea w-full font-mono text-sm hidden",
                    rows: 10, data: { "slide-editor-target": "source", action: "input->slide-editor#onSourceInput" } %>
            </div>

            <div data-slide-editor-target="pageFields"></div>
            <p class="label whitespace-normal"><%= t("slides.form.pages_help") %></p>

            <%# Countdown settings (insert or edit a ⏱ chip). It sits inside the slide form, so it
                has NO nested <form> (a modal-backdrop form broke CI before) and its inputs have no
                name: nothing here is submitted, the editor writes the chip into the page text. %>
            <dialog class="modal" data-slide-editor-target="countdownDialog" data-role="countdown-dialog"
                    data-chip-to="<%= t("slides.form.countdown.chip_to", t: "%{t}") %>" data-chip-for="<%= t("slides.form.countdown.chip_for", m: "%{m}") %>">
              <div class="modal-box max-w-md">
                <h3 class="font-bold text-lg mb-3"><%= t("slides.form.countdown.title") %></h3>
                <label class="label cursor-pointer gap-2 text-base-content whitespace-normal">
                  <%# A shared name makes the two radios exclusive; form= pointing at no form keeps
                      them out of the slide form's submission. %>
                  <input type="radio" class="radio radio-sm" name="countdown_mode" form="slide-countdown-unsubmitted"
                         value="to" data-slide-editor-target="countdownMode" checked>
                  <span><%= t("slides.form.countdown.mode_to") %></span>
                </label>
                <input type="time" class="input w-full mt-1 mb-3" data-slide-editor-target="countdownTo" aria-label="<%= t('slides.form.countdown.mode_to') %>">
                <label class="label cursor-pointer gap-2 text-base-content whitespace-normal">
                  <input type="radio" class="radio radio-sm" name="countdown_mode" form="slide-countdown-unsubmitted"
                         value="for" data-slide-editor-target="countdownMode">
                  <span><%= t("slides.form.countdown.mode_for") %></span>
                </label>
                <label class="input w-full mt-1 mb-3">
                  <input type="number" min="1" max="999" step="1" value="5" data-slide-editor-target="countdownMinutes" aria-label="<%= t('slides.form.countdown.mode_for') %>">
                  <span class="label"><%= t("slides.form.countdown.minutes") %></span>
                </label>
                <fieldset class="fieldset">
                  <legend class="fieldset-legend"><%= t("slides.form.countdown.end_label") %></legend>
                  <input type="text" maxlength="60" class="input w-full" data-slide-editor-target="countdownEnd"
                         placeholder="<%= t('slides.form.countdown.end_placeholder') %>">
                  <p class="label whitespace-normal"><%= t("slides.form.countdown.end_help") %></p>
                </fieldset>
                <p class="text-xs text-base-content/60 mt-2"><%= t("slides.form.countdown.clock_note") %></p>
                <div class="modal-action">
                  <button type="button" class="btn btn-ghost" data-action="slide-editor#closeCountdown"><%= t("slides.form.countdown.cancel") %></button>
                  <button type="button" class="btn btn-primary" data-action="slide-editor#saveCountdown" data-role="countdown-save"><%= t("slides.form.countdown.save") %></button>
                </div>
              </div>
              <div class="modal-backdrop" data-action="click->slide-editor#closeCountdown"></div>
            </dialog>
          </fieldset>

          <%# Auto-advance pages: the projector turns the pages itself and the slide becomes one
              operator step. Also offered on imported decks (announcement decks from Keynote/PDF).
              The options stay submitted while off (inert, not disabled) so the loop checkbox keeps
              its value; the model clears the interval when the toggle is off. %>
          <%# Collapsed by default, like the Appearance sections; the title shows whether it is on. %>
          <details class="collapse collapse-arrow border border-base-300 bg-base-100" data-role="auto-advance"<%= " open" if text_slide.errors[:auto_advance_seconds].any? || text_slide.errors[:auto_advance_transition].any? %>>
            <summary class="collapse-title font-semibold text-sm">
              <%= t("slides.form.auto_advance.legend") %>
              <span class="font-normal text-base-content/60" data-role="auto-advance-summary" data-slide-editor-target="autoSummary"
                    data-off="<%= t('slides.form.auto_advance.summary_off') %>"
                    data-on="<%= t('slides.form.auto_advance.summary_on', s: '%{s}') %>">· <%= text_slide.auto_advance ? t("slides.form.auto_advance.summary_on", s: text_slide.auto_advance_seconds) : t("slides.form.auto_advance.summary_off") %></span>
            </summary>
            <div class="collapse-content">
            <label class="label cursor-pointer gap-3 text-base-content">
              <%= f.check_box :auto_advance, { class: "toggle toggle-primary toggle-sm",
                    data: { "slide-editor-target": "autoToggle", action: "change->slide-editor#updateAutoAdvance" } }, "1", "0" %>
              <span><%= t("slides.form.auto_advance.toggle") %></span>
            </label>
            <%# Seconds + transition side by side, the loop checkbox on its own row: this panel is
                narrow (the preview sits beside it), so three columns would clip the loop label. %>
            <div class="mt-2<%= ' opacity-50' unless text_slide.auto_advance %>"
                 data-slide-editor-target="autoOptions" <%= "inert" unless text_slide.auto_advance %>>
              <div class="grid grid-cols-2 gap-3">
              <fieldset class="fieldset">
                <%= f.label :auto_advance_seconds, t("slides.form.auto_advance.seconds"), class: "fieldset-legend" %>
                <%= f.number_field :auto_advance_seconds, value: text_slide.auto_advance_seconds || TextSlide::AUTO_ADVANCE_DEFAULT_SECONDS,
                      min: 2, max: 600, step: 1, class: "input w-full",
                      data: { "slide-editor-target": "autoSeconds", action: "input->slide-editor#updateAutoAdvance" } %>
              </fieldset>
              <fieldset class="fieldset">
                <%= f.label :auto_advance_transition, t("slides.form.auto_advance.transition"), class: "fieldset-legend" %>
                <%= f.select :auto_advance_transition,
                      TextSlide::AUTO_ADVANCE_TRANSITIONS.map { |v| [ t("slides.form.auto_advance.transitions.#{v}"), v ] }, {},
                      class: "select w-full",
                      data: { "slide-editor-target": "autoTransition", action: "change->slide-editor#updateAutoAdvance" } %>
              </fieldset>
              </div>
              <label class="label cursor-pointer gap-2 text-base-content whitespace-normal mt-2">
                <%= f.check_box :auto_advance_loop, { class: "checkbox checkbox-sm",
                      data: { "slide-editor-target": "autoLoop", action: "change->slide-editor#updateAutoAdvance" } } %>
                <span><%= t("slides.form.auto_advance.loop") %></span>
              </label>
            </div>
            <p class="label whitespace-normal" data-slide-editor-target="autoHint" data-role="auto-advance-hint"
               data-off="<%= t('slides.form.auto_advance.hint_off') %>"
               data-on-loop="<%= t('slides.form.auto_advance.hint_on_loop', s: '%{s}', total: '%{total}') %>"
               data-on-stop="<%= t('slides.form.auto_advance.hint_on_stop', s: '%{s}') %>"></p>
            </div>
          </details>

          <%# Appearance (all pages): collapsed by default so writing the slide comes first. Each
              header shows the current choice; the slide editor keeps it in sync. %>
          <div class="flex flex-col gap-2<%= ' hidden' if text_slide.imported? %>" data-role="slide-appearance">
            <div class="text-xs font-semibold uppercase tracking-wide text-base-content/50"><%= t("slides.form.appearance_label") %></div>
            <details class="collapse collapse-arrow border border-base-300 bg-base-100" data-role="slide-section-background"<%= " open" if text_slide.errors[:bg_type].any? || text_slide.errors[:bg_color].any? || text_slide.errors[:bg_color2].any? || text_slide.errors[:bg_gradient_angle].any? || text_slide.errors[:background_image].any? %>>
              <summary class="collapse-title font-semibold text-sm">
                <%= t("slides.form.section_background") %>
                <span class="font-normal text-base-content/60" data-role="slide-summary-background">· <%= t("slides.form.bg_type.#{text_slide.bg_type}") %></span>
              </summary>
              <div class="collapse-content">
                <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-2" data-role="slide-look">
                <fieldset class="fieldset sm:col-span-2">
                  <div class="join w-full" role="radiogroup" data-role="slide-bg-type"
                       data-action="change->slide-editor#updateLook">
                    <% Church::BG_TYPE_OPTIONS.each do |value| %>
                      <%= f.radio_button :bg_type, value,
                            class: "join-item btn btn-sm flex-1 #{'btn-primary' if text_slide.bg_type == value}",
                            aria: { label: t("slides.form.bg_type.#{value}") } %>
                    <% end %>
                  </div>
                </fieldset>

                <fieldset class="fieldset" data-look-for="solid gradient">
                  <%= f.label :bg_color, t("slides.form.bg_color"), class: "fieldset-legend" %>
                  <%= f.color_field :bg_color, class: "input h-10 w-full p-1",
                        data: { role: "slide-bg-color", action: "input->slide-editor#updateLook" } %>
                </fieldset>

                <fieldset class="fieldset" data-look-for="gradient">
                  <%= f.label :bg_color2, t("slides.form.bg_color2"), class: "fieldset-legend" %>
                  <%= f.color_field :bg_color2, class: "input h-10 w-full p-1",
                        data: { role: "slide-bg-color2", action: "input->slide-editor#updateLook" } %>
                </fieldset>

                <fieldset class="fieldset sm:col-span-2" data-look-for="gradient">
                  <%= f.label :bg_gradient_angle, t("slides.form.bg_gradient_angle"), class: "fieldset-legend" %>
                  <label class="input flex items-center gap-2 w-full">
                    <%= f.range_field :bg_gradient_angle, min: 0, max: 360, step: 5, class: "range range-sm grow",
                          data: { role: "slide-bg-angle", action: "input->slide-editor#updateLook" } %>
                    <span class="text-base-content/60 text-sm whitespace-nowrap" data-role="slide-bg-angle-label"><%= text_slide.bg_gradient_angle %>°</span>
                  </label>
                </fieldset>

                <fieldset class="fieldset sm:col-span-2" data-look-for="image">
                  <%= f.label :background_image, t("slides.form.background_image_label"), class: "fieldset-legend" %>
                  <% if text_slide.background_image.attached? %>
                    <div class="flex items-center gap-3" data-role="slide-bg-current">
                      <%= image_tag rails_blob_path(text_slide.background_image, only_path: true),
                            class: "h-14 w-24 object-cover rounded border border-base-300", alt: t("slides.form.current_background_alt") %>
                      <label class="label">
                        <%= f.check_box :remove_background_image, { class: "checkbox checkbox-sm" }, "1", "0" %>
                        <%= t("slides.form.remove") %>
                      </label>
                    </div>
                  <% end %>
                  <%= f.file_field :background_image, accept: "image/png,image/jpeg,image/webp,image/gif",
                        class: "file-input w-full",
                        data: { role: "slide-bg-image", action: "change->slide-editor#previewImage" } %>
                  <p class="label whitespace-normal"><%= t("slides.form.background_help_html") %></p>
                </fieldset>
                </div>
              </div>
            </details>
            <details class="collapse collapse-arrow border border-base-300 bg-base-100" data-role="slide-section-text"<%= " open" if text_slide.errors[:text_color].any? || text_slide.errors[:font].any? || text_slide.errors[:font_size].any? %>>
              <summary class="collapse-title font-semibold text-sm">
                <%= t("slides.form.section_text") %>
                <span class="font-normal text-base-content/60" data-role="slide-summary-text" data-auto-label="<%= t("slides.form.font_size_auto_short") %>">· <%= t("settings.projection.font_#{text_slide.font}") %>, <%= text_slide.font_size ? t("slides.form.font_size_percent", percent: text_slide.font_size) : t("slides.form.font_size_auto_short") %></span>
              </summary>
              <div class="collapse-content">
                <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-2">
                  <fieldset class="fieldset">
                    <%= f.label :text_color, t("slides.form.text_color"), class: "fieldset-legend" %>
                    <%= f.color_field :text_color, class: "input h-10 w-full p-1",
                          data: { role: "slide-text-color", action: "input->slide-editor#updateLook" } %>
                  </fieldset>

                  <fieldset class="fieldset">
                    <%= f.label :font, t("slides.form.font_label"), class: "fieldset-legend" %>
                    <%= f.select :font, Church::FONT_OPTIONS.map { |v| [ t("settings.projection.font_#{v}"), v ] }, {},
                          class: "select w-full", data: { role: "slide-font", action: "change->slide-editor#updateLook" } %>
                  </fieldset>

                <fieldset class="fieldset sm:col-span-2">
                  <%= f.label :font_size, t("slides.form.font_size_label"), class: "fieldset-legend" %>
                  <%= f.select :font_size,
                        [ [ t("slides.form.font_size_auto"), "" ] ] + TextSlide::FONT_SIZE_OPTIONS.map { |n| [ t("slides.form.font_size_percent", percent: n), n ] },
                        {}, class: "select w-full",
                        data: { role: "slide-font-size", action: "change->slide-editor#setFontSize" } %>
                  <p class="label whitespace-normal"><%= t("slides.form.font_size_help") %></p>
                </fieldset>
                </div>
              </div>
            </details>
            <details class="collapse collapse-arrow border border-base-300 bg-base-100" data-role="slide-section-position"<%= " open" if text_slide.errors[:text_align].any? || text_slide.errors[:vertical_align].any? %>>
              <summary class="collapse-title font-semibold text-sm">
                <%= t("slides.form.section_position") %>
                <span class="font-normal text-base-content/60" data-role="slide-summary-position">· <%= t("slides.form.text_align.#{text_slide.text_align}") %>, <%= t("slides.form.vertical_align.#{text_slide.vertical_align}") %></span>
              </summary>
              <div class="collapse-content">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <fieldset class="fieldset">
                  <legend class="fieldset-legend"><%= t("slides.form.text_align_label") %></legend>
                  <div class="join w-full" role="radiogroup" data-role="slide-text-align"
                       data-action="change->slide-editor#setAlignment">
                    <% TextSlide::TEXT_ALIGN_OPTIONS.each do |value| %>
                      <%= f.radio_button :text_align, value,
                            class: "join-item btn btn-sm flex-1 #{'btn-primary' if text_slide.text_align == value}",
                            aria: { label: t("slides.form.text_align.#{value}") } %>
                    <% end %>
                  </div>
                </fieldset>
                <fieldset class="fieldset">
                  <legend class="fieldset-legend"><%= t("slides.form.vertical_align_label") %></legend>
                  <div class="join w-full" role="radiogroup" data-role="slide-vertical-align"
                       data-action="change->slide-editor#setAlignment">
                    <% TextSlide::VERTICAL_ALIGN_OPTIONS.each do |value| %>
                      <%= f.radio_button :vertical_align, value,
                            class: "join-item btn btn-sm flex-1 #{'btn-primary' if text_slide.vertical_align == value}",
                            aria: { label: t("slides.form.vertical_align.#{value}") } %>
                    <% end %>
                  </div>
                </fieldset>
                </div>
              </div>
            </details>
          </div>
        </div>

        <%# ── Preview column (inside the same card) — the SAME projector mini-stage the show page
              and operator use, so what you see while editing matches what projects. ───── %>
        <% if text_slide.imported? %>
          <div class="min-w-0" data-role="imported-pages">
            <div class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-2"><%= t("slides.form.imported_pages", count: text_slide.page_count) %></div>
            <div class="grid grid-cols-2 gap-2">
              <% text_slide.page_images_attachments.sort_by(&:id).each_with_index do |image, i| %>
                <figure class="relative">
                  <%= image_tag rails_blob_path(image, only_path: true), alt: "#{text_slide.title} #{i + 1}",
                        class: "w-full aspect-video object-contain bg-black rounded-box" %>
                  <figcaption class="badge badge-neutral badge-sm absolute top-1 left-1"><%= i + 1 %></figcaption>
                </figure>
              <% end %>
            </div>
          </div>
        <% end %>
        <div class="lg:sticky lg:top-4 min-w-0<%= ' hidden' if text_slide.imported? %>">
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="text-xs font-semibold uppercase tracking-wide text-base-content/50"><%= t("slides.form.preview_label") %> <span data-slide-editor-target="previewLabel"></span></div>
            <%# Shown only while auto-advance plays the pages in the preview. %>
            <button type="button" class="btn btn-ghost btn-xs hidden" data-slide-editor-target="autoPause" data-role="auto-pause"
                    data-pause="<%= t('slides.form.auto_advance.pause') %>" data-play="<%= t('slides.form.auto_advance.play') %>"
                    data-action="slide-editor#togglePause"><%= t("slides.form.auto_advance.pause") %></button>
          </div>
          <div class="projector-preview rounded-box overflow-hidden" data-slide-editor-target="previewStage"
               style="<%= text_slide.projector_style %>">
            <%# Always present so the editor can switch to Image mode (or preview a new upload) live;
                hidden unless the slide is showing an image. %>
            <div class="projector-slide-bg<%= ' hidden' unless text_slide.background_image? %>" data-role="slide-bg"
                 data-slide-editor-target="previewBg"
                 data-current-url="<%= rails_blob_path(text_slide.background_image, only_path: true) if text_slide.background_image.attached? %>"
                 style="<%= "background-image: url('#{rails_blob_path(text_slide.background_image, only_path: true)}');" if text_slide.background_image.attached? %>">
              <div class="projector-slide-scrim"></div>
            </div>
            <div class="projector-slide <%= text_slide.alignment_classes %><%= ' has-bg' if text_slide.background_image? %>" data-controller="fit" data-role="projector-slide"
                 data-slide-editor-target="previewSlide"
                 data-fit-fixed-value="<%= text_slide.font_size.to_i %>">
              <div class="projector-slide-body" data-fit-target="content" data-slide-editor-target="preview" data-role="slide-preview"></div>
            </div>
          </div>
          <%# Time left on the current page while auto-advance plays (DaisyUI progress). %>
          <progress class="progress progress-primary w-full h-1 mt-1 hidden" value="0" max="100"
                    data-slide-editor-target="autoBar" data-role="auto-progress"></progress>
          <p class="text-xs text-base-content/40 mt-2"><%= t("slides.form.preview_caption") %></p>
        </div>
      </div>

      <%# Actions span the full card width, below both columns. %>
      <div class="card-actions items-center gap-3 mt-6 pt-4 border-t border-base-200">
        <%= f.submit (text_slide.persisted? ? t("slides.form.save") : t("slides.form.create")), class: "btn btn-primary",
              data: { "slide-editor-target": "submit" } %>
        <% if local_assigns[:modal] %>
          <button type="button" class="btn btn-ghost" data-action="set-builder#closeNewSlide"><%= t("slides.form.cancel") %></button>
        <% else %>
          <%= link_to t("slides.form.cancel"), (text_slide.persisted? ? text_slide_path(text_slide) : text_slides_path), class: "btn btn-ghost" %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Seed data for the controller: existing tags + pages as JSON. %>
  <script type="application/json" data-slide-editor-target="seed"><%= raw({ tags: text_slide.tags, pages: text_slide.pages.map { |p| p["body_markdown"].to_s } }.to_json) %></script>
<% end %>
