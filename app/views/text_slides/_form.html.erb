<%= form_with model: text_slide,
      data: { controller: "slide-editor", "slide-editor-url-value": preview_text_slides_path } do |f| %>
  <% if text_slide.errors.any? %>
    <div class="alert alert-error mb-4 text-sm" data-role="slide-errors">
      <span><%= text_slide.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%# ── Editor ──────────────────────────────────────────────────── %>
    <div class="card bg-base-100 ring-1 ring-base-200">
      <div class="card-body gap-4">
        <fieldset class="fieldset">
          <%= f.label :title, "Title", class: "fieldset-legend" %>
          <%= f.text_field :title, class: "input input-bordered w-full", placeholder: "Slide title" %>
        </fieldset>

        <%# ── Tags ───────────────────────────────────────────────── %>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Tags</legend>
          <div class="flex flex-wrap items-center gap-1.5 rounded-lg border border-base-300 px-2 py-1.5 min-h-10 focus-within:border-primary cursor-text"
               data-action="click->slide-editor#focusTag">
            <span class="contents" data-slide-editor-target="tagChips"></span>
            <input type="text" list="church-tags" placeholder="Add a tag…"
                   class="flex-1 min-w-32 bg-transparent border-0 focus:outline-none text-sm py-0.5"
                   data-slide-editor-target="tagInput" data-action="keydown->slide-editor#onTagKey">
          </div>
          <datalist id="church-tags">
            <% (local_assigns[:church_tags] || []).each do |t| %><option value="<%= t %>"><% end %>
          </datalist>
          <p class="label">Type a tag and press Enter. Used to organize and search slides.</p>
          <%# hidden tag inputs are injected here by the controller %>
          <div data-slide-editor-target="tagFields"></div>
        </fieldset>

        <%# ── Pages ──────────────────────────────────────────────── %>
        <fieldset class="fieldset">
          <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-medium">Pages</span>
            <button type="button" class="btn btn-ghost btn-xs" data-slide-editor-target="advancedBtn" data-action="slide-editor#toggleAdvanced">Advanced</button>
          </div>

          <%# ── Page thumbnail strip: click to switch, drag to reorder, ✕ to remove, + to add ── %>
          <div class="flex gap-2 overflow-x-auto pb-2 mb-2" data-slide-editor-target="pageStrip"></div>

          <div class="flex flex-wrap gap-1 mb-1 rounded-t-lg border border-base-300 bg-base-200 px-1 py-1" data-slide-editor-target="toolbar">
            <button type="button" class="btn btn-ghost btn-xs font-bold" title="Bold (⌘B)" data-action="slide-editor#bold">B</button>
            <button type="button" class="btn btn-ghost btn-xs italic" title="Italic (⌘I)" data-action="slide-editor#italic">I</button>
            <button type="button" class="btn btn-ghost btn-xs" title="Heading" data-action="slide-editor#heading">H</button>
            <button type="button" class="btn btn-ghost btn-xs" title="Bulleted list" data-action="slide-editor#bullet">• List</button>
            <button type="button" class="btn btn-ghost btn-xs" title="Clear formatting" data-action="slide-editor#clearFormat">Clear</button>
          </div>

          <div contenteditable="true" role="textbox" aria-multiline="true" aria-label="Slide body"
               class="rich-body min-h-48 rounded-b-lg border border-base-300 border-t-0 px-3 py-2 focus:outline-none prose max-w-none"
               data-slide-editor-target="rich" data-action="input->slide-editor#onRichInput keydown->slide-editor#onKeydown"></div>

          <textarea rows="10" class="textarea textarea-bordered w-full font-mono text-sm mt-2 hidden"
                    data-slide-editor-target="source" data-action="input->slide-editor#onSourceInput"></textarea>

          <%# hidden page body inputs injected by the controller %>
          <div data-slide-editor-target="pageFields"></div>

          <p class="label">
            Type your text and use the buttons to format it — no codes to learn. Add pages when the text is too long for one screen.
          </p>
        </fieldset>

        <div class="flex items-center gap-3">
          <%= f.submit (text_slide.persisted? ? "Save changes" : "Create slide"), class: "btn btn-primary",
                data: { "slide-editor-target": "submit" } %>
          <% if local_assigns[:modal] %>
            <button type="button" class="btn btn-ghost" data-action="set-builder#closeNewSlide">Cancel</button>
          <% else %>
            <%= link_to "Cancel", (text_slide.persisted? ? text_slide_path(text_slide) : text_slides_path), class: "btn btn-ghost" %>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── Live preview ────────────────────────────────────────────── %>
    <div class="lg:sticky lg:top-4 self-start">
      <div class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-2">Preview <span data-slide-editor-target="previewLabel"></span></div>
      <div class="rounded-xl bg-neutral text-neutral-content p-6 min-h-48 flex items-center justify-center text-center">
        <div class="slide-preview prose prose-invert max-w-none" data-slide-editor-target="preview" data-role="slide-preview"></div>
      </div>
      <p class="text-xs text-base-content/40 mt-2">This is roughly how the current page appears on the projection screen.</p>
    </div>
  </div>

  <%# Seed data for the controller: existing tags + pages as JSON. %>
  <script type="application/json" data-slide-editor-target="seed"><%= raw({ tags: text_slide.tags, pages: text_slide.pages.map { |p| p["body_markdown"].to_s } }.to_json) %></script>
<% end %>
