<%= form_with model: text_slide, data: { controller: "slide-editor", "slide-editor-url-value": preview_text_slides_path } do |f| %>
  <% if text_slide.errors.any? %>
    <div class="alert alert-error mb-4 text-sm" data-role="slide-errors">
      <span><%= text_slide.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%# ── Editor ──────────────────────────────────────────────────── %>
    <div class="card bg-base-100 ring-1 ring-base-200">
      <div class="card-body gap-4">
        <label class="form-control">
          <span class="label-text text-sm mb-1 block">Title</span>
          <%= f.text_field :title, class: "input input-bordered w-full", placeholder: "Slide title" %>
        </label>

        <label class="form-control">
          <span class="label-text text-sm mb-1 block">Type</span>
          <%= f.select :subtype, TextSlide.subtypes.keys.map { |s| [ s.humanize, s ] }, {},
                class: "select select-bordered w-full",
                data: { "slide-editor-target": "subtype", action: "change->slide-editor#render" } %>
          <span class="label-text-alt text-xs text-base-content/50 mt-1 block">Styles how the slide looks on the projector.</span>
        </label>

        <div class="form-control">
          <div class="flex items-center justify-between mb-1">
            <span class="label-text text-sm">Body</span>
            <button type="button" class="btn btn-ghost btn-xs" data-slide-editor-target="advancedBtn"
                    data-action="slide-editor#toggleAdvanced">Advanced</button>
          </div>

          <%# Formatting toolbar — drives the contenteditable; no syntax shown to the user. %>
          <div class="flex flex-wrap gap-1 mb-1 rounded-t-lg border border-base-300 bg-base-200 px-1 py-1"
               data-slide-editor-target="toolbar">
            <button type="button" class="btn btn-ghost btn-xs font-bold" title="Bold (⌘B)" data-action="slide-editor#bold">B</button>
            <button type="button" class="btn btn-ghost btn-xs italic" title="Italic (⌘I)" data-action="slide-editor#italic">I</button>
            <button type="button" class="btn btn-ghost btn-xs" title="Heading" data-action="slide-editor#heading">H</button>
            <button type="button" class="btn btn-ghost btn-xs" title="Bulleted list" data-action="slide-editor#bullet">• List</button>
            <button type="button" class="btn btn-ghost btn-xs" title="Clear formatting" data-action="slide-editor#clearFormat">Clear</button>
          </div>

          <%# WYSIWYG surface. Author types here; markdown is generated into the hidden field below. %>
          <div contenteditable="true" role="textbox" aria-multiline="true" aria-label="Slide body"
               class="rich-body min-h-48 rounded-b-lg border border-base-300 border-t-0 px-3 py-2 focus:outline-none prose max-w-none"
               data-slide-editor-target="rich" data-action="input->slide-editor#onRichInput keydown->slide-editor#onKeydown"></div>

          <%# Advanced raw markdown (hidden by default); the canonical stored field. %>
          <%= f.text_area :body_markdown, rows: 10,
                class: "textarea textarea-bordered w-full font-mono text-sm mt-2 hidden",
                data: { "slide-editor-target": "source", action: "input->slide-editor#onSourceInput" } %>

          <span class="label-text-alt text-xs text-base-content/50 mt-1 block">
            Type your text and use the buttons to format it — no codes to learn.
          </span>
        </div>

        <div class="flex items-center gap-3">
          <%= f.submit (text_slide.persisted? ? "Save changes" : "Create slide"), class: "btn btn-primary" %>
          <%= link_to "Cancel", (text_slide.persisted? ? text_slide_path(text_slide) : text_slides_path), class: "btn btn-ghost" %>
        </div>
      </div>
    </div>

    <%# ── Live preview ────────────────────────────────────────────── %>
    <div class="lg:sticky lg:top-4 self-start">
      <div class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-2">Preview</div>
      <div class="rounded-xl bg-neutral text-neutral-content p-6 min-h-48 flex items-center justify-center text-center">
        <div class="slide-preview prose prose-invert max-w-none" data-slide-editor-target="preview"
             data-role="slide-preview"></div>
      </div>
      <p class="text-xs text-base-content/40 mt-2">This is roughly how the slide appears on the projection screen.</p>
    </div>
  </div>
<% end %>
