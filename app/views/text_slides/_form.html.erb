<%= form_with model: text_slide do |f| %>
  <% if text_slide.errors.any? %>
    <div class="mb-4 rounded bg-red-100 text-red-800 px-3 py-2 text-sm">
      <%= text_slide.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, "Title", class: "block text-sm mb-1" %>
    <%= f.text_field :title, class: "w-full border rounded px-2 py-1" %>
  </div>

  <div class="mb-4">
    <%= f.label :subtype, "Type", class: "block text-sm mb-1" %>
    <%= f.select :subtype, TextSlide.subtypes.keys.map { |s| [ s.humanize, s ] }, {}, class: "w-full border rounded px-2 py-1" %>
  </div>

  <div class="mb-4">
    <%= f.label :body_markdown, "Body (markdown)", class: "block text-sm mb-1" %>
    <%= f.text_area :body_markdown, rows: 10, class: "w-full border rounded px-2 py-1 font-mono text-sm" %>
  </div>

  <%= f.submit class: "rounded bg-slate-800 text-white px-3 py-2" %>
<% end %>
