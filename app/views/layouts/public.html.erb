<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title><%= content_for(:title) || "Corobook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-base-100 text-base-content min-h-screen flex flex-col">
    <header class="navbar border-b border-base-200 px-4 sm:px-6">
      <div class="navbar-start">
        <%= link_to root_path, class: "text-xl font-bold" do %>Corobook<% end %>
      </div>
      <div class="navbar-end gap-2">
        <%= link_to "Sign in", login_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "Create account", signup_path, class: "btn btn-primary btn-sm" %>
      </div>
    </header>

    <main class="flex-1 w-full"><%= yield %></main>

    <footer class="border-t border-base-200 px-4 sm:px-6 py-6 text-sm text-base-content/50">
      <div class="mx-auto max-w-5xl flex flex-wrap items-center justify-between gap-2">
        <span>© <%= Date.current.year %> Corobook</span>
        <span>Worship presentation & song management for churches.</span>
      </div>
    </footer>
  </body>
</html>
