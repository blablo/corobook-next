<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title><%= content_for(:title) || "Corobook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200">
    <div class="drawer lg:drawer-open">
      <input id="app-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex flex-col min-h-screen">
        <%# ── Top header ───────────────────────────────────────────── %>
        <header class="bg-base-100 border-b border-base-200 sticky top-0 z-30">
          <div class="mx-auto w-full max-w-screen-2xl px-4 sm:px-6 h-16 flex items-center gap-3">
            <div class="lg:hidden">
              <label for="app-drawer" class="btn btn-square btn-ghost" aria-label="Open menu">☰</label>
            </div>
            <%# Brand shows in the header only on mobile, where the sidebar (which carries it) is hidden. %>
            <%= link_to root_path, class: "text-lg font-semibold lg:hidden" do %>Corobook<% end %>
            <% if respond_to?(:current_church) && current_church %>
              <span class="badge badge-ghost whitespace-nowrap" data-role="church-name"><%= current_church.name %></span>
            <% end %>
            <div class="flex-1"></div>
            <% if respond_to?(:current_user) && current_user %>
              <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-2 max-w-[12rem]">
                  <span class="truncate" data-role="user-email"><%= current_user.email %></span>
                  <span class="badge badge-sm badge-ghost hidden sm:inline-flex"><%= current_user.role %></span>
                </div>
                <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-50 w-48 p-2 shadow mt-2">
                  <li class="menu-title text-xs"><%= current_user.email %></li>
                  <li><%= button_to "Sign out", logout_path, method: :delete, class: "w-full text-left" %></li>
                </ul>
              </div>
            <% end %>
          </div>
        </header>

        <main class="flex-1 w-full">
          <div class="mx-auto w-full max-w-screen-2xl px-4 sm:px-6 py-6">
            <% if flash[:notice] %>
              <div class="alert alert-success mb-4 flex items-center justify-between" data-role="flash-notice"
                   data-controller="flash" data-flash-delay-value="4000" role="status">
                <span><%= flash[:notice] %></span>
                <button type="button" class="btn btn-ghost btn-xs btn-circle" aria-label="Dismiss"
                        data-action="flash#dismiss">✕</button>
              </div>
            <% end %>
            <% if flash[:alert] %>
              <div class="alert alert-error mb-4 flex items-center justify-between" data-role="flash-alert"
                   data-controller="flash" data-flash-delay-value="7000" role="alert">
                <span><%= flash[:alert] %></span>
                <button type="button" class="btn btn-ghost btn-xs btn-circle" aria-label="Dismiss"
                        data-action="flash#dismiss">✕</button>
              </div>
            <% end %>
            <%= yield %>
          </div>
        </main>
      </div>

      <%# ── Left sidebar ───────────────────────────────────────────── %>
      <div class="drawer-side z-40">
        <label for="app-drawer" class="drawer-overlay" aria-label="Close menu"></label>
        <%= render "shared/sidebar" %>
      </div>
    </div>
  </body>
</html>
