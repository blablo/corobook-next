<!DOCTYPE html>
<html data-theme="light" lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Corobook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200">
    <div class="drawer lg:drawer-open">
      <input id="app-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex flex-col min-h-screen overflow-x-hidden">
        <%# ── Top navbar (DaisyUI navbar component) ─────────────────── %>
        <header class="navbar bg-base-100 border-b border-base-200 sticky top-0 z-30 min-h-16 px-4 sm:px-6 gap-3">
          <div class="navbar-start gap-3">
            <div class="lg:hidden">
              <label for="app-drawer" class="btn btn-square btn-ghost" aria-label="Open menu">☰</label>
            </div>
            <%# Brand shows in the navbar only on mobile, where the sidebar (which carries it) is hidden. %>
            <%= link_to root_path, class: "text-lg font-semibold lg:hidden" do %>Corobook<% end %>
            <% if respond_to?(:current_church) && current_church %>
              <span class="text-base font-medium text-base-content whitespace-nowrap truncate max-w-[12rem] sm:max-w-xs" data-role="church-name"><%= current_church.name %></span>
            <% end %>
          </div>
          <div class="navbar-end">
            <%# Language switcher: EN / ES. Links re-request the current path with ?locale=,
                which the Localized concern applies and (for a signed-in user) persists. %>
            <div class="dropdown dropdown-end" data-role="locale-switcher">
              <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-1" aria-label="<%= t('common.language') %>">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"/></svg>
                <span class="uppercase text-xs font-semibold"><%= current_locale %></span>
              </div>
              <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-50 w-40 p-2 shadow mt-2">
                <li><%= link_to t("common.english"), url_for(locale: :en), class: (current_locale == :en ? "menu-active" : ""), data: { role: "locale-en" } %></li>
                <li><%= link_to t("common.spanish"), url_for(locale: :es), class: (current_locale == :es ? "menu-active" : ""), data: { role: "locale-es" } %></li>
              </ul>
            </div>
            <% if respond_to?(:current_user) && current_user %>
              <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-2 max-w-[12rem]">
                  <span class="truncate" data-role="user-email"><%= current_user.email %></span>
                  <span class="badge badge-sm badge-ghost hidden sm:inline-flex"><%= current_user.role %></span>
                </div>
                <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-50 w-48 p-2 shadow mt-2">
                  <li class="menu-title text-xs"><%= current_user.email %></li>
                  <li><%= button_to t("common.sign_out"), logout_path, method: :delete, class: "w-full text-left" %></li>
                </ul>
              </div>
            <% end %>
          </div>
        </header>

        <main class="flex-1 w-full">
          <div class="w-full px-4 sm:px-6 py-6">
            <% if flash[:notice] %>
              <div class="alert alert-success mb-4 flex items-center justify-between" data-role="flash-notice"
                   data-controller="flash" data-flash-delay-value="4000" role="status">
                <span><%= flash[:notice] %></span>
                <button type="button" class="btn btn-ghost btn-xs btn-circle" aria-label="Dismiss"
                        data-action="flash#dismiss">✕</button>
              </div>
            <% end %>
            <% if flash[:alert] %>
              <div class="alert alert-error mb-4 flex items-center justify-between" data-role="flash-alert"
                   data-controller="flash" data-flash-delay-value="7000" role="alert">
                <span><%= flash[:alert] %></span>
                <button type="button" class="btn btn-ghost btn-xs btn-circle" aria-label="Dismiss"
                        data-action="flash#dismiss">✕</button>
              </div>
            <% end %>
            <%= yield %>
          </div>
        </main>
      </div>

      <%# ── Left sidebar ───────────────────────────────────────────── %>
      <div class="drawer-side z-40">
        <label for="app-drawer" class="drawer-overlay" aria-label="Close menu"></label>
        <%= render "shared/sidebar" %>
      </div>
    </div>
  </body>
</html>
