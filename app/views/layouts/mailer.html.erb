<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>Corobook</title>
    <%#
      premailer-rails inlines this CSS into each element at send time (email clients strip
      <style> blocks), so write normal CSS here and let it flatten to inline styles.
      Layout is table-based for Outlook/Gmail; a centered branded card on a soft background.
    %>
    <style>
      body { margin: 0; padding: 0; background-color: #f8f8f8; }
      table { border-collapse: collapse; }
      .wrap { width: 100%; background-color: #f8f8f8; padding: 32px 0; }
      .card {
        width: 100%; max-width: 480px; margin: 0 auto;
        background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px;
        overflow: hidden;
        font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      .header {
        background-color: #422ad5; padding: 20px 28px;
        font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      .brand {
        color: #ffffff; font-size: 18px; font-weight: 700; letter-spacing: 0.01em;
        text-decoration: none;
      }
      .brand-mark {
        display: inline-block; width: 26px; height: 26px; line-height: 26px;
        background-color: #ffffff; color: #422ad5; border-radius: 7px;
        font-weight: 800; text-align: center; margin-right: 8px; font-size: 15px;
      }
      .body { padding: 28px; color: #18181b; font-size: 15px; line-height: 1.6; }
      .body p { margin: 0 0 16px; }
      .btn-wrap { padding: 8px 0 20px; }
      .btn {
        display: inline-block; background-color: #422ad5; color: #ffffff !important;
        text-decoration: none; font-weight: 600; font-size: 15px;
        padding: 12px 24px; border-radius: 8px;
      }
      .muted { color: #6b7280; font-size: 13px; }
      .link-fallback { color: #422ad5; word-break: break-all; font-size: 13px; }
      .footer {
        padding: 18px 28px; color: #9ca3af; font-size: 12px; text-align: center;
        border-top: 1px solid #f3f4f6;
        font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      a { color: #422ad5; }
    </style>
  </head>
  <body>
    <table role="presentation" class="wrap" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table role="presentation" class="card" width="480" cellpadding="0" cellspacing="0">
            <tr>
              <td class="header">
                <span class="brand"><span class="brand-mark">C</span>Corobook</span>
              </td>
            </tr>
            <tr>
              <td class="body">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td class="footer">
                <%= t("auth.mailer.footer", year: Date.current.year) %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
