<div class="mx-auto mt-16 max-w-sm text-center px-4" data-role="invitation-invalid">
  <h1 class="text-2xl font-bold mb-2">This invitation is no longer valid</h1>
  <p class="text-sm text-base-content/60 mb-6">
    The link may have expired or already been used. Ask whoever invited you to send a new one.
  </p>
  <%= link_to "Go to sign in", login_path, class: "link link-hover text-sm" %>
</div>
