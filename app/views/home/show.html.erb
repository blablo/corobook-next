<% content_for :title, "Corobook" %>

<div class="space-y-6" data-role="home">
  <%# ── Header + song search ─────────────────────────────────────── %>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold"><%= t("home.dashboard.title") %></h1>
      <p class="text-base-content/60 mt-1"><%= t("home.dashboard.subtitle") %></p>
    </div>
    <%= form_with url: songs_path, method: :get, class: "w-full sm:w-80", data: { role: "song-search" } do %>
      <label class="input w-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/></svg>
        <%= search_field_tag :q, nil, placeholder: t("home.dashboard.search_placeholder"),
              class: "grow", aria: { label: t("home.dashboard.search_aria") } %>
      </label>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    <%# ── Hero: the one job of this screen, get the next service live ── %>
    <section class="card card-border bg-base-100 lg:col-span-2" data-role="hero">
      <% if @hero_set.nil? %>
        <div class="card-body items-start">
          <span class="badge badge-soft badge-primary badge-sm"><%= t("home.hero.get_started") %></span>
          <h2 class="text-2xl font-semibold"><%= t("home.hero.no_services") %></h2>
          <p class="text-base-content/60 max-w-prose"><%= t("home.hero.no_services_body") %></p>
          <%= link_to t("home.hero.create_first"), new_service_set_path, class: "btn btn-primary mt-2", data: { role: "new-set" } %>
        </div>
      <% else %>
        <% items = @hero_set.set_items.to_a %>
        <% date = @hero_set.service_date %>
        <% live = @active_session.present? %>
        <div class="card-body sm:flex-row sm:items-center gap-5">
          <%= render "service_sets/date_block", date: date, big: true %>
          <div class="grow min-w-0 space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <% if live %>
                <span class="badge badge-soft badge-success badge-sm gap-1.5">
                  <span class="status status-success animate-pulse" aria-hidden="true"></span><%= t("home.hero.live_now") %>
                </span>
              <% else %>
                <span class="badge badge-soft badge-primary badge-sm"><%= t("home.hero.next_service") %></span>
                <% if date && date < Date.current %>
                  <span class="badge badge-soft badge-warning badge-sm" data-role="past-badge"><%= t("home.hero.past_service") %></span>
                <% elsif date %>
                  <span class="text-xs text-base-content/60"><%= days_until(date) %></span>
                <% end %>
              <% end %>
            </div>
            <h2 class="text-2xl font-semibold leading-tight">
              <%= link_to @hero_set.name, service_set_path(@hero_set), class: "link link-hover" %>
            </h2>
            <% if items.empty? %>
              <p class="text-base-content/60" data-role="empty-set-hint"><%= t("home.hero.empty_set_hint") %></p>
            <% else %>
              <p class="text-base-content/60 truncate"><%= set_items_preview(@hero_set) %></p>
              <div class="flex gap-2">
                <% { songs: set_song_count(@hero_set), slides: set_slide_count(@hero_set) }.each do |kind, n| %>
                  <% next if n.zero? %>
                  <span class="badge badge-ghost badge-sm"><%= t("services.index.#{kind}", count: n) %></span>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="flex flex-wrap sm:flex-col sm:items-end items-center gap-2 shrink-0">
            <% if live %>
              <%= link_to t("home.hero.resume"), operator_path(@active_session), class: "btn btn-success", data: { role: "resume" } %>
            <% elsif items.empty? %>
              <%= link_to t("home.hero.add_items"), service_set_path(@hero_set), class: "btn btn-primary", data: { role: "add-items" } %>
            <% else %>
              <%= button_to t("home.hero.go_live"), launch_service_set_path(@hero_set), method: :post,
                    class: "btn btn-primary", data: { role: "go-live" } %>
              <%= link_to t("home.hero.edit_service"), service_set_path(@hero_set), class: "btn btn-ghost btn-sm" %>
            <% end %>
            <% if date.blank? && !live %>
              <%= link_to t("home.hero.set_date"), edit_service_set_path(@hero_set), class: "btn btn-link btn-sm" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>

    <%# ── Recent services ───────────────────────────────────────────── %>
    <section class="card card-border bg-base-100">
      <div class="card-body p-0">
        <div class="flex items-center justify-between px-5 pt-4">
          <h2 class="card-title text-base"><%= t("home.recent.title") %></h2>
          <%= link_to t("home.recent.all"), service_sets_path, class: "link link-hover text-sm" %>
        </div>
        <% if @recent_sets.any? %>
          <ul class="list" data-role="recent-sets">
            <% @recent_sets.each do |set| %>
              <% item_count = set.set_items.size %>
              <li class="list-row items-center hover:bg-base-200">
                <%= render "service_sets/date_block", date: set.service_date %>
                <%= link_to service_set_path(set), class: "list-col-grow min-w-0" do %>
                  <span class="block font-medium truncate"><%= set.name %></span>
                  <span class="block text-xs text-base-content/60"><%= t("home.recent.items", count: item_count) %></span>
                <% end %>
                <% if item_count.positive? && @active_session.nil? %>
                  <%= button_to t("home.recent.go_live"), launch_service_set_path(set), method: :post,
                        class: "btn btn-primary btn-sm", data: { role: "recent-go-live" },
                        title: t("home.recent.go_live_with", name: set.name) %>
                <% elsif item_count.zero? %>
                  <%= link_to t("home.recent.add_items"), service_set_path(set),
                        class: "btn btn-ghost btn-sm", data: { role: "recent-add-items" } %>
                <% else %>
                  <%# a session is already live: open the set rather than offer a second launch %>
                  <%= link_to t("home.recent.open"), service_set_path(set), class: "btn btn-ghost btn-sm" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="px-5 pb-5 pt-2 text-base-content/60"><%= t("home.recent.empty") %></p>
        <% end %>
      </div>
    </section>
  </div>

  <%# ── Library: one card per area, with its count and a create action ── %>
  <section class="grid grid-cols-1 sm:grid-cols-3 gap-4" data-role="library-stats">
    <% [
         [ :songs, songs_path, new_song_path, :new_song,
           "M9 9 19.5 6.75v8.25M9 9v8.25M9 9l-.75.161M9 17.25a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm10.5-2.25a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" ],
         [ :slides, text_slides_path, new_text_slide_path, :new_slide, "M3.75 3.75h16.5v12.75H3.75zM12 16.5v3.75m-3 0h6" ],
         [ :sets, service_sets_path, new_service_set_path, :new_service,
           "M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" ]
       ].each do |key, index_path, new_path, new_key, icon| %>
      <div class="card card-border bg-base-100 hover:border-primary transition-colors relative">
        <div class="card-body flex-row items-center gap-4 p-5">
          <span class="inline-grid place-items-center size-11 rounded-box bg-base-200 text-primary shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/></svg>
          </span>
          <%= link_to index_path, class: "grow min-w-0 after:absolute after:inset-0" do %>
            <span class="block text-sm text-base-content/60"><%= t("home.library.#{key == :sets ? :services : key}") %></span>
            <span class="block text-3xl font-semibold leading-tight"><%= @counts[key] %></span>
          <% end %>
          <%# Above the stretched card link so it stays its own click target. %>
          <%= link_to new_path, class: "btn btn-ghost btn-sm relative z-10", data: { role: "new-#{key}" },
                aria: { label: t("home.create.#{new_key}") } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            <span class="hidden lg:inline"><%= t("home.create.new") %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</div>
