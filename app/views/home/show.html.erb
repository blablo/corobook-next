<% content_for :title, "Corobook" %>

<div class="flex flex-col gap-6" data-role="home">

  <%# ── Page header + global song search ────────────────────────────── %>
  <div class="flex flex-col sm:flex-row sm:items-center gap-3">
    <div class="flex-1">
      <h1 class="text-2xl font-bold">Dashboard</h1>
      <p class="text-sm text-base-content/60">Build sets, manage your library, and go live.</p>
    </div>
    <%= form_with url: songs_path, method: :get, class: "join w-full sm:w-80", data: { role: "song-search" } do %>
      <%= search_field_tag :q, nil, placeholder: "Search songs…",
            class: "input input-bordered join-item w-full", "aria-label": "Search songs" %>
      <button type="submit" class="btn btn-neutral join-item" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/></svg>
      </button>
    <% end %>
  </div>

  <%# ── Top row: dominant hero (2/3) + recent sets (1/3) ────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

    <%# Hero — the one job of this screen: get the next service live %>
    <section class="lg:col-span-2 card bg-base-100 shadow-md ring-1 ring-base-200 overflow-hidden" data-role="hero">
      <div class="h-1.5 bg-primary"></div>
      <div class="card-body gap-4">
        <% if @hero_set.nil? %>
          <p class="text-xs font-semibold uppercase tracking-wide text-primary">Get started</p>
          <h2 class="text-2xl font-bold">No sets yet</h2>
          <p class="text-base-content/70 max-w-prose">Create your first set to start building a service — add songs and slides, then go live to the projector.</p>
          <div class="card-actions">
            <%= link_to new_service_set_path, class: "btn btn-primary btn-lg", data: { role: "new-set" } do %>
              Create your first set
            <% end %>
          </div>
        <% else %>
          <% item_count = @hero_set.set_items.count %>
          <% past = @hero_set.service_date.present? && @hero_set.service_date < Date.current %>
          <div class="flex items-center gap-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-primary">
              <%= @active_session ? "Live now" : "Next service" %>
            </p>
            <% if @active_session %>
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-error">
                <span class="relative flex size-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-error opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-error"></span></span>
                ON AIR
              </span>
            <% end %>
          </div>

          <h2 class="text-3xl font-bold leading-tight">
            <%= @hero_set.name %>
            <% if past %><span class="badge badge-warning align-middle" data-role="past-badge">Past service</span><% end %>
          </h2>
          <p class="text-base-content/70">
            <%= @hero_set.service_date&.strftime("%A, %B %-d") || "No date set" %>
            · <%= pluralize(item_count, "item") %>
          </p>

          <div class="card-actions items-center gap-3 mt-1">
            <% if @active_session %>
              <%= link_to "Resume service", operator_path(@active_session),
                    class: "btn btn-primary btn-lg", data: { role: "resume" } %>
            <% elsif item_count.zero? %>
              <%= link_to "Add items", service_set_path(@hero_set),
                    class: "btn btn-primary btn-lg", data: { role: "add-items" } %>
              <span class="text-sm text-base-content/60" data-role="empty-set-hint">This set has no items yet — add songs or slides first.</span>
            <% else %>
              <%= button_to "Go live", launch_service_set_path(@hero_set), method: :post,
                    class: "btn btn-primary btn-lg gap-2", data: { role: "go-live" } %>
              <%= link_to "Edit set", service_set_path(@hero_set), class: "btn btn-ghost btn-lg" %>
            <% end %>
            <% if @hero_set.service_date.blank? && !@active_session %>
              <%= link_to "Set a date", edit_service_set_path(@hero_set), class: "btn btn-link btn-sm px-0" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <%# Recent sets — a resume surface %>
    <section class="card bg-base-100 shadow-sm ring-1 ring-base-200">
      <div class="card-body gap-2">
        <div class="flex items-center justify-between">
          <h3 class="font-semibold">Recent sets</h3>
          <%= link_to "All", service_sets_path, class: "link link-hover text-sm text-base-content/60" %>
        </div>
        <% if @recent_sets.any? %>
          <ul class="-mx-2 max-h-80 overflow-y-auto" data-role="recent-sets">
            <% @recent_sets.each do |set| %>
              <% set_items = set.set_items.count %>
              <li class="flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-base-200 transition-colors">
                <span class="inline-grid place-items-center size-9 rounded-lg bg-base-200 text-base-content/70 shrink-0">
                  <%# Document/list icon — reads as "a set", not a drag handle %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>
                </span>
                <%= link_to service_set_path(set), class: "min-w-0 flex-1" do %>
                  <span class="block font-medium truncate"><%= set.name %></span>
                  <span class="block text-xs text-base-content/60">
                    <%= set.service_date&.strftime("%b %-d") || "No date" %> · <%= pluralize(set_items, "item") %>
                  </span>
                <% end %>
                <% if set_items.positive? && @active_session.nil? %>
                  <%= button_to launch_service_set_path(set), method: :post,
                        class: "btn btn-primary btn-xs shrink-0", data: { role: "recent-go-live" },
                        title: "Go live with #{set.name}" do %>
                    Go live
                  <% end %>
                <% elsif set_items.zero? %>
                  <%= link_to "Add items", service_set_path(set),
                        class: "btn btn-ghost btn-xs text-base-content/60 shrink-0", data: { role: "recent-add-items" } %>
                <% else %>
                  <%# a session is already live — open the set rather than offer a second launch %>
                  <%= link_to "Open", service_set_path(set), class: "btn btn-ghost btn-xs text-base-content/60 shrink-0" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-base-content/60 py-4">No sets yet.</p>
        <% end %>
      </div>
    </section>
  </div>

  <%# ── Quick actions — real tiles ──────────────────────────────────── %>
  <section data-role="quick-actions">
    <h3 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-2">Create</h3>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <%= link_to new_service_set_path,
            class: "card bg-base-100 ring-1 ring-base-200 hover:ring-primary hover:shadow-md transition-all" do %>
        <div class="card-body flex-row items-center gap-3 p-4">
          <span class="inline-grid place-items-center size-10 rounded-lg bg-primary/10 text-primary shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          </span>
          <span class="font-medium">New set</span>
        </div>
      <% end %>
      <%= link_to new_song_path,
            class: "card bg-base-100 ring-1 ring-base-200 hover:ring-primary hover:shadow-md transition-all" do %>
        <div class="card-body flex-row items-center gap-3 p-4">
          <span class="inline-grid place-items-center size-10 rounded-lg bg-primary/10 text-primary shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9 19.5 6.75v8.25M9 9v8.25M9 9l-.75.161M9 17.25a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm10.5-2.25a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/></svg>
          </span>
          <span class="font-medium">New song</span>
        </div>
      <% end %>
      <%= link_to new_text_slide_path,
            class: "card bg-base-100 ring-1 ring-base-200 hover:ring-primary hover:shadow-md transition-all" do %>
        <div class="card-body flex-row items-center gap-3 p-4">
          <span class="inline-grid place-items-center size-10 rounded-lg bg-primary/10 text-primary shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75h16.5v12.75H3.75zM12 16.5v3.75m-3 0h6"/></svg>
          </span>
          <span class="font-medium">New slide</span>
        </div>
      <% end %>
    </div>
  </section>

  <%# ── Library at a glance — clickable stat cards ──────────────────── %>
  <section data-role="library-stats">
    <h3 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-2">Library</h3>
    <div class="grid grid-cols-3 gap-3">
      <%= link_to songs_path,
            class: "card bg-base-100 ring-1 ring-base-200 hover:ring-primary hover:shadow-md transition-all" do %>
        <div class="card-body p-4 gap-0">
          <span class="text-xs text-base-content/60">Songs</span>
          <span class="text-3xl font-bold leading-tight"><%= @counts[:songs] %></span>
        </div>
      <% end %>
      <%= link_to text_slides_path,
            class: "card bg-base-100 ring-1 ring-base-200 hover:ring-primary hover:shadow-md transition-all" do %>
        <div class="card-body p-4 gap-0">
          <span class="text-xs text-base-content/60">Slides</span>
          <span class="text-3xl font-bold leading-tight"><%= @counts[:slides] %></span>
        </div>
      <% end %>
      <%= link_to service_sets_path,
            class: "card bg-base-100 ring-1 ring-base-200 hover:ring-primary hover:shadow-md transition-all" do %>
        <div class="card-body p-4 gap-0">
          <span class="text-xs text-base-content/60">Sets</span>
          <span class="text-3xl font-bold leading-tight"><%= @counts[:sets] %></span>
        </div>
      <% end %>
    </div>
  </section>

</div>
