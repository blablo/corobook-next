<% content_for :title, t("home.landing.page_title") %>

<div data-role="landing">
  <%# ── Hero ─────────────────────────────────────────────────────── %>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-16 pb-12 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary mb-3"><%= t("home.landing.eyebrow") %></p>
    <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight tracking-tight max-w-3xl mx-auto">
      <%= t("home.landing.headline") %>
    </h1>
    <p class="mt-4 text-lg text-base-content/70 max-w-2xl mx-auto">
      <%= t("home.landing.subhead") %>
    </p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <%= link_to t("home.landing.cta_signup"), signup_path, class: "btn btn-primary btn-lg", data: { role: "cta-signup" } %>
      <%= link_to t("home.landing.sign_in"), login_path, class: "btn btn-ghost btn-lg" %>
    </div>
  </section>

  <%# ── Feature highlights ───────────────────────────────────────── %>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pb-20">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% [
        [t("home.landing.features.build.title"), t("home.landing.features.build.body")],
        [t("home.landing.features.project.title"), t("home.landing.features.project.body")],
        [t("home.landing.features.key.title"), t("home.landing.features.key.body")],
        [t("home.landing.features.editor.title"), t("home.landing.features.editor.body")],
        [t("home.landing.features.arrangements.title"), t("home.landing.features.arrangements.body")],
        [t("home.landing.features.ccli.title"), t("home.landing.features.ccli.body")]
      ].each do |title, body| %>
        <div class="card bg-base-100 card-border">
          <div class="card-body gap-1">
            <h3 class="font-semibold"><%= title %></h3>
            <p class="text-sm text-base-content/70"><%= body %></p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-12 text-center">
      <%= link_to t("home.landing.cta_signup"), signup_path, class: "btn btn-primary btn-lg" %>
      <p class="mt-2 text-sm text-base-content/50"><%= t("home.landing.cta_note") %></p>
    </div>
  </section>
</div>
