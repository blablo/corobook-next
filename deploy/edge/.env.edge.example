# Shared edge proxy env — copy to deploy/edge/.env.edge on the server and fill in.
# Only Corobook is wired by default; add your other sites by editing deploy/edge/Caddyfile.

# The DuckDNS hostname Corobook is served at. Its A record must point at this server's public IP.
COROBOOK_HOST=corobook.duckdns.org
