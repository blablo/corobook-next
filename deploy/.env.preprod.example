# Preprod environment — copy to deploy/.env.preprod on the server and fill in.
# deploy/.env.preprod is gitignored (holds secrets); this .example is the committed template.

# ── The DuckDNS hostname this preprod serves (no scheme). Its A record must point at this
#    server's public IP. Caddy gets a Let's Encrypt cert for it automatically. ──
APP_HOST=corobook-preprod.duckdns.org

# ── Rails secret key base / credentials decryptor. Copy from config/master.key (do NOT commit). ──
RAILS_MASTER_KEY=

# ── Postgres password for the corobook_next role (used by app + the postgres container). ──
COROBOOK_NEXT_DATABASE_PASSWORD=

# ── Mail (optional for preprod). If MAIL_DOMAIN isn't a Resend-verified domain, confirmation
#    emails won't deliver — but the on-screen fallback link still works. See docs/mail-setup.md. ──
MAIL_DOMAIN=example.com
MAIL_FROM=Corobook <no-reply@example.com>
