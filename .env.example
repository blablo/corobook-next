# Corobook — environment variables (TEMPLATE, no secrets).
# Copy to .env for local overrides, or set these in your production host's env.
# The Resend API key (RESEND_API_KEY) is the one true secret — set it in your host's
# env (deploy/.env.prod on the server), NOT committed here. See docs/mail-setup.md.

# ── App host (used to build absolute links in emails: confirmation, invitations) ──
# Your real production domain, no scheme. Must be reachable over HTTPS.
APP_HOST=corobook.example.com

# ── From address for all outgoing mail ──
# MAIL_DOMAIN must be a domain you have VERIFIED in Resend (SPF/DKIM DNS records added),
# otherwise delivery is rejected. MAIL_FROM is the full From header.
MAIL_DOMAIN=example.com
MAIL_FROM=Corobook <no-reply@example.com>

# ── Resend API key — authenticates SMTP sending (re_...) ──
# Required for mail to actually send. Get one at https://resend.com -> API Keys.
# On the server this lives in deploy/.env.prod (gitignored). Leave unset to disable
# sending (the on-screen confirmation/invitation link still works as a fallback).
RESEND_API_KEY=

# ── Notes ─────────────────────────────────────────────────────────────────────
# Legacy fallback: if RESEND_API_KEY is unset, production.rb also reads the key from
# Rails encrypted credentials (bin/rails credentials:edit -> resend.api_key). The env
# var is preferred and takes precedence; you do not need both.
