# Corobook — environment variables (TEMPLATE, no secrets).
# Copy to .env for local overrides, or set these in your production host's env.
# The one true secret (the Resend API key) does NOT live here — it goes in Rails
# encrypted credentials. See docs/mail-setup.md.

# ── App host (used to build absolute links in emails: confirmation, invitations) ──
# Your real production domain, no scheme. Must be reachable over HTTPS.
APP_HOST=corobook.example.com

# ── From address for all outgoing mail ──
# MAIL_DOMAIN must be a domain you have VERIFIED in Resend (SPF/DKIM DNS records added),
# otherwise delivery is rejected. MAIL_FROM is the full From header.
MAIL_DOMAIN=example.com
MAIL_FROM=Corobook <no-reply@example.com>

# ── Notes ─────────────────────────────────────────────────────────────────────
# The Resend API key is NOT an env var here. Store it in encrypted credentials:
#   bin/rails credentials:edit
# then add:
#   resend:
#     api_key: re_xxxxxxxxxxxxxxxxxxxxxxxx
# production.rb reads it via Rails.application.credentials.dig(:resend, :api_key).
